	dxSpreadSheetFunctionsStrs_sfnHypgeomDistDescription,	L"Returns the hypergeometric distribution, that is, the probability of a specified number of sample successes at a specific sample size, number of population successes, and population size."
	dxSpreadSheetFunctionsStrs_sfnLogInv,	L"LOGINV"
	dxSpreadSheetFunctionsStrs_sfnLogInvDescription,	L"Calculates the inverse of the lognormal cumulative distribution."
	dxSpreadSheetFunctionsStrs_sfnLogNormDist,	L"LOGNORMDIST"
	dxSpreadSheetFunctionsStrs_sfnLogNormDistDescription,	L"Returns the cumulative lognormal distribution."
	dxSpreadSheetFunctionsStrs_sfnMode,	L"MODE"
