"inLibMsgArticulos.STituloIncidenciasImportacionInventario": ("Incidencias en la importación del inventario", "src/Lib/inLibMsgArticulos.pas", "Incidències en la importació de l'inventari", "Inventory import issues", "库存导入问题"),
"inLibMsgArticulos.STextoIncidenciasImportacionInventario": ("No se ha importado ninguna línea. Corrige estas incidencias en el archivo y vuelve a intentarlo:", "src/Lib/inLibMsgArticulos.pas", "No s'ha importat cap línia. Corregiu aquestes incidències al fitxer i torneu-ho a provar:", "No lines were imported. Correct these issues in the file and try again:", "未导入任何行。请修正文件中的以下问题，然后重试："),
"inLibMsgArticulos.SFormatoIncidenciaCantidadImportacionInventario": ("Fila %d | SKU: \"%s\" | Cantidad: \"%s\" | Debe ser un número válido mayor o igual que cero.", "src/Lib/inLibMsgArticulos.pas", "Fila %d | SKU: \"%s\" | Quantitat: \"%s\" | Ha de ser un número vàlid superior o igual a zero.", "Row %d | SKU: \"%s\" | Quantity: \"%s\" | It must be a valid number greater than or equal to zero.", "行 %d | SKU：\"%s\" | 数量：\"%s\" | 必须是大于或等于零的有效数字。"),
"inLibMsgArticulos.SFormatoIncidenciaPmpNuevoImportacionInventario": ("Fila %d | SKU: \"%s\" | PMP nuevo: \"%s\" | Debe ser un número válido mayor o igual que cero.", "src/Lib/inLibMsgArticulos.pas", "Fila %d | SKU: \"%s\" | PMP nou: \"%s\" | Ha de ser un número vàlid superior o igual a zero.", "Row %d | SKU: \"%s\" | New PMP: \"%s\" | It must be a valid number greater than or equal to zero.", "行 %d | SKU：\"%s\" | 新 PMP：\"%s\" | 必须是大于或等于零的有效数字。"),
"inLibMsgCompras.SErrorReversionSesionMigracionPendiente": ("No se puede revertir la sesion: falta aplicar la migracion reversion_sesiones_bloqueos_concurrentes.sql en la base de datos.", "src/Lib/inLibMsgCompras.pas", "No es pot revertir la sessió: falta aplicar la migració reversion_sesiones_bloqueos_concurrentes.sql a la base de dades.", "The session cannot be reversed: the reversion_sesiones_bloqueos_concurrentes.sql migration must be applied to the database.", "无法撤销会话：必须先在数据库中应用迁移 reversion_sesiones_bloqueos_concurrentes.sql。"),
"inLibMsgCompras.SErrorReversionSesionConIncidencias": ("No se puede revertir la sesion porque sus documentos tienen dependencias:\r\n%s\r\nNo se ha modificado ningun dato.", "src/Lib/inLibMsgCompras.pas", "No es pot revertir la sessió perquè els seus documents tenen dependències:\r\n%s\r\nNo s'ha modificat cap dada.", "The session cannot be reversed because its documents have dependencies:\r\n%s\r\nNo data was changed.", "无法撤销会话，因为其单据存在依赖关系：\r\n%s\r\n未修改任何数据。"),
"inLibMsgCompras.SIncidenciaReversionFacturaCompra": ("- El albaran de compra %s esta incluido en la factura de compra %s.", "src/Lib/inLibMsgCompras.pas", "- L'albarà de compra %s està inclòs en la factura de compra %s.", "- Purchase delivery note %s is included in purchase invoice %s.", "- 采购收货单 %s 已包含在采购发票 %s 中。"),
"inLibMsgCompras.SIncidenciaReversionSalidaPosterior": ("- El albaran de compra %s no puede revertirse por una venta, otra salida posterior o datos de stock no verificables: %s.", "src/Lib/inLibMsgCompras.pas", "- L'albarà de compra %s no es pot revertir a causa d'una venda, una altra sortida posterior o dades d'estoc no verificables: %s.", "- Purchase delivery note %s cannot be reversed because of a sale, another subsequent stock issue or unverifiable stock data: %s.", "- 采购收货单 %s 无法撤销，原因是存在销售、后续出库或无法验证的库存数据：%s。"),
"inLibMsgCompras.SIncidenciaReversionPedidoRecibido": ("- El pedido de compra %s ya fue recibido o tiene un albaran dependiente: %s.", "src/Lib/inLibMsgCompras.pas", "- La comanda de compra %s ja s'ha rebut o té un albarà dependent: %s.", "- Purchase order %s has already been received or has a dependent delivery note: %s.", "- 采购订单 %s 已收货或存在关联收货单：%s。"),
"inLibMsgCompras.SIncidenciaReversionTipoDocumento": ("- La sesion contiene un documento de tipo no soportado: %s %s.", "src/Lib/inLibMsgCompras.pas", "- La sessió conté un tipus de document no admès: %s %s.", "- The session contains an unsupported document type: %s %s.", "- 会话包含不支持的单据类型：%s %s。"),
"inLibMsgCompras.SIncidenciaReversionDocumentoIncompleto": ("- La sesion contiene una referencia %s incompleta (serie \"%s\", numero \"%s\").", "src/Lib/inLibMsgCompras.pas", "- La sessió conté una referència %s incompleta (sèrie \"%s\", número \"%s\").", "- The session contains an incomplete %s reference (series \"%s\", number \"%s\").", "- 会话包含不完整的 %s 引用（系列 \"%s\"，编号 \"%s\"）。"),
"inLibMsgCompras.SIncidenciaReversionReferenciaSinMapa": ("- La referencia %s %s de la cabecera no aparece en el mapa de documentos de la sesion.", "src/Lib/inLibMsgCompras.pas", "- La referència %s %s de la capçalera no apareix al mapa de documents de la sessió.", "- Header reference %s %s does not appear in the session document map.", "- 表头引用 %s %s 未出现在会话单据映射中。"),
"inLibMsgCompras.SIncidenciaReversionDocumentoCompartido": ("- El documento %s %s tambien esta vinculado a la sesion %s.", "src/Lib/inLibMsgCompras.pas", "- El document %s %s també està vinculat a la sessió %s.", "- Document %s %s is also linked to session %s.", "- 单据 %s %s 还关联到会话 %s。"),
"inLibMsgConexion.SErrorMotorBBDDNoReconocido": ("Motor de base de datos no reconocido.", "src/Lib/inLibMsgConexion.pas", "Motor de base de dades no reconegut.", "Unrecognised database engine.", "无法识别的数据库引擎。"),
"inLibMsgConexion.SErrorMotorBBDDNoSoportado": ("El motor de base de datos \"%s\" no está soportado.", "src/Lib/inLibMsgConexion.pas", "El motor de base de dades \"%s\" no és compatible.", "The \"%s\" database engine is not supported.", "不支持数据库引擎“%s”。"),
"inLibMsgConexion.SErrorModoSSLNoSoportado": ("El modo SSL \"%s\" no está soportado.", "src/Lib/inLibMsgConexion.pas", "El mode SSL \"%s\" no és compatible.", "SSL mode \"%s\" is not supported.", "不支持 SSL 模式“%s”。"),
"inLibMsgConexion.SErrorValorPerfilNoBooleano": ("El valor %s.%s no es booleano.", "src/Lib/inLibMsgConexion.pas", "El valor %s.%s no és booleà.", "The value %s.%s is not Boolean.", "值 %s.%s 不是布尔值。"),
"inLibMsgConexion.SErrorValorPerfilNoEntero": ("El valor %s.%s no es un número entero.", "src/Lib/inLibMsgConexion.pas", "El valor %s.%s no és un nombre enter.", "The value %s.%s is not an integer.", "值 %s.%s 不是整数。"),
"inLibMsgConexion.SErrorRutaPerfilConexionObligatoria": ("La ruta del perfil de conexión es obligatoria.", "src/Lib/inLibMsgConexion.pas", "La ruta del perfil de connexió és obligatòria.", "The connection profile path is required.", "必须指定连接配置文件路径。"),
"inLibMsgConexion.SErrorPerfilConexionNoValido": ("El perfil de conexión no es válido: %s.", "src/Lib/inLibMsgConexion.pas", "El perfil de connexió no és vàlid: %s.", "The connection profile is invalid: %s.", "连接配置无效：%s。"),
"inLibMsgConexion.SErrorReferenciaCredencialObligatoria": ("La referencia de credencial es obligatoria.", "src/Lib/inLibMsgConexion.pas", "La referència de la credencial és obligatòria.", "The credential reference is required.", "必须指定凭据引用。"),
"inLibMsgConexion.SErrorReferenciaCredencialAjena": ("La referencia de credencial no pertenece a Factuzam.", "src/Lib/inLibMsgConexion.pas", "La referència de la credencial no pertany a Factuzam.", "The credential reference does not belong to Factuzam.", "该凭据引用不属于 Factuzam。"),
"inLibMsgConexion.SErrorCredencialLegadaInvalida": ("La credencial de conexión legada no se puede descifrar.", "src/Lib/inLibMsgConexion.pas", "La credencial de connexió antiga no es pot desxifrar.", "The legacy connection credential cannot be decrypted.", "无法解密旧版连接凭据。"),
"inLibMsgConexion.SErrorLeerCredencialConexion": ("No se pudo leer la credencial de conexión (error %d).", "src/Lib/inLibMsgConexion.pas", "No s'ha pogut llegir la credencial de connexió (error %d).", "The connection credential could not be read (error %d).", "无法读取连接凭据（错误 %d）。"),
"inLibMsgConexion.SErrorFormatoCredencialConexion": ("La credencial de conexión almacenada no tiene un formato válido.", "src/Lib/inLibMsgConexion.pas", "La credencial de connexió emmagatzemada no té un format vàlid.", "The stored connection credential has an invalid format.", "存储的连接凭据格式无效。"),
"inLibMsgConexion.SErrorGuardarCredencialConexion": ("No se pudo guardar la credencial de conexión (error %d).", "src/Lib/inLibMsgConexion.pas", "No s'ha pogut desar la credencial de connexió (error %d).", "The connection credential could not be saved (error %d).", "无法保存连接凭据（错误 %d）。"),
"inLibMsgConexion.SErrorEliminarCredencialConexion": ("No se pudo eliminar la credencial de conexión (error %d).", "src/Lib/inLibMsgConexion.pas", "No s'ha pogut eliminar la credencial de connexió (error %d).", "The connection credential could not be deleted (error %d).", "无法删除连接凭据（错误 %d）。"),
"inLibMsgConexion.SErrorEliminarCredencialLegadaIni": ("No se pudo retirar la credencial legada del perfil de conexión.", "src/Lib/inLibMsgConexion.pas", "No s'ha pogut retirar la credencial antiga del perfil de connexió.", "The legacy credential could not be removed from the connection profile.", "无法从连接配置中删除旧版凭据。"),
"inLibMsgConexion.SValidacionMotorBBDD": ("El motor de base de datos no es válido", "src/Lib/inLibMsgConexion.pas", "El motor de base de dades no és vàlid", "The database engine is invalid", "数据库引擎无效"),
"inLibMsgConexion.SValidacionIdPerfilConexion": ("El identificador del perfil es obligatorio", "src/Lib/inLibMsgConexion.pas", "L'identificador del perfil és obligatori", "The profile identifier is required", "必须指定配置标识符"),
"inLibMsgConexion.SValidacionServidorConexion": ("El servidor es obligatorio", "src/Lib/inLibMsgConexion.pas", "El servidor és obligatori", "The server is required", "必须指定服务器"),
"inLibMsgConexion.SValidacionPuertoConexion": ("El puerto debe estar entre 1 y 65535", "src/Lib/inLibMsgConexion.pas", "El port ha d'estar entre 1 i 65535", "The port must be between 1 and 65535", "端口必须介于 1 和 65535 之间"),
"inLibMsgConexion.SValidacionBaseDatosConexion": ("La base de datos es obligatoria", "src/Lib/inLibMsgConexion.pas", "La base de dades és obligatòria", "The database is required", "必须指定数据库"),
"inLibMsgConexion.SValidacionEsquemaPostgreSQL": ("El esquema es obligatorio para PostgreSQL", "src/Lib/inLibMsgConexion.pas", "L'esquema és obligatori per a PostgreSQL", "The schema is required for PostgreSQL", "PostgreSQL 必须指定架构"),
"inLibMsgConexion.SValidacionEsquemaMotor": ("El esquema es obligatorio para el motor seleccionado", "src/Lib/inLibMsgConexion.pas", "L'esquema és obligatori per al motor seleccionat", "The schema is required for the selected engine", "所选引擎必须指定架构"),
"inLibMsgConexion.SValidacionUsuarioConexion": ("El usuario es obligatorio", "src/Lib/inLibMsgConexion.pas", "L'usuari és obligatori", "The user is required", "必须指定用户"),
"inLibMsgConexion.SValidacionModoSSLConexion": ("El modo SSL no es válido", "src/Lib/inLibMsgConexion.pas", "El mode SSL no és vàlid", "The SSL mode is invalid", "SSL 模式无效"),
"inLibMsgConexion.SValidacionTimeoutConexion": ("El timeout de conexión debe ser mayor que cero", "src/Lib/inLibMsgConexion.pas", "El temps d'espera de connexió ha de ser superior a zero", "The connection timeout must be greater than zero", "连接超时必须大于零"),
"inLibMsgConexion.SValidacionTimeoutComando": ("El timeout de comando debe ser mayor que cero", "src/Lib/inLibMsgConexion.pas", "El temps d'espera de l'ordre ha de ser superior a zero", "The command timeout must be greater than zero", "命令超时必须大于零"),
"inLibMsgConexion.SValidacionPoolMinimoNegativo": ("El mínimo del pool no puede ser negativo", "src/Lib/inLibMsgConexion.pas", "El mínim del pool no pot ser negatiu", "The connection pool minimum cannot be negative", "连接池最小值不能为负数"),
"inLibMsgConexion.SValidacionPoolMaximoNegativo": ("El máximo del pool no puede ser negativo", "src/Lib/inLibMsgConexion.pas", "El màxim del pool no pot ser negatiu", "The connection pool maximum cannot be negative", "连接池最大值不能为负数"),
"inLibMsgConexion.SValidacionPoolEsperaNegativa": ("La espera del pool no puede ser negativa", "src/Lib/inLibMsgConexion.pas", "L'espera del pool no pot ser negativa", "The connection pool wait time cannot be negative", "连接池等待时间不能为负数"),
"inLibMsgConexion.SValidacionPoolVidaNegativa": ("La vida de una conexión no puede ser negativa", "src/Lib/inLibMsgConexion.pas", "La vida d'una connexió no pot ser negativa", "A connection lifetime cannot be negative", "连接生存期不能为负数"),
"inLibMsgConexion.SValidacionPoolVidaFueraDeRango": ("La vida de una conexión supera el máximo admitido", "src/Lib/inLibMsgConexion.pas", "La vida d'una connexió supera el màxim admès", "A connection lifetime exceeds the permitted maximum", "连接生存期超过允许的最大值"),
"inLibMsgConexion.SValidacionPoolMaximoCero": ("El máximo del pool debe ser mayor que cero", "src/Lib/inLibMsgConexion.pas", "El màxim del pool ha de ser superior a zero", "The connection pool maximum must be greater than zero", "连接池最大值必须大于零"),
"inLibMsgConexion.SValidacionPoolMinimoMayorMaximo": ("El mínimo del pool no puede superar al máximo", "src/Lib/inLibMsgConexion.pas", "El mínim del pool no pot superar el màxim", "The connection pool minimum cannot exceed its maximum", "连接池最小值不能大于最大值"),
"inLibMsgConexion.SValidacionPoolEsperaCero": ("La espera del pool debe ser mayor que cero", "src/Lib/inLibMsgConexion.pas", "L'espera del pool ha de ser superior a zero", "The connection pool wait time must be greater than zero", "连接池等待时间必须大于零"),
"inLibMsgConexion.SValidacionCertificadosSinSSL": ("No se admiten certificados con SSL desactivado", "src/Lib/inLibMsgConexion.pas", "No s'admeten certificats amb SSL desactivat", "Certificates are not permitted when SSL is disabled", "禁用 SSL 时不能使用证书"),
"inLibMsgConexion.SValidacionCertificadoCA": ("La verificación SSL necesita un certificado de CA", "src/Lib/inLibMsgConexion.pas", "La verificació SSL necessita un certificat de CA", "SSL verification requires a CA certificate", "SSL 验证需要 CA 证书"),
"inLibMsgConexion.SValidacionCertificadoCliente": ("El certificado de cliente y su clave deben indicarse juntos", "src/Lib/inLibMsgConexion.pas", "El certificat de client i la seva clau s'han d'indicar junts", "The client certificate and its key must be specified together", "必须同时指定客户端证书及其密钥"),
"inLibMsgConexion.SDescripcionPerfilConexion": ("%s [%s] %s:%d/%s%s; ssl=%s", "src/Lib/inLibMsgConexion.pas", "%s [%s] %s:%d/%s%s; ssl=%s", "%s [%s] %s:%d/%s%s; ssl=%s", "%s [%s] %s:%d/%s%s; ssl=%s"),
"inLibMsgConexion.SDescripcionEsquemaConexion": ("; esquema=%s", "src/Lib/inLibMsgConexion.pas", "; esquema=%s", "; schema=%s", "; 架构=%s"),
"inLibMsgConexion.SErrorConexionPrincipalNoAsignada": ("La conexión principal no está asignada.", "src/Lib/inLibMsgConexion.pas", "La connexió principal no està assignada.", "The main connection has not been assigned.", "尚未分配主连接。"),
"inLibMsgConexion.SErrorFabricaConexionesNoAsignada": ("La fábrica de conexiones no está asignada.", "src/Lib/inLibMsgConexion.pas", "La fàbrica de connexions no està assignada.", "The connection factory has not been assigned.", "尚未分配连接工厂。"),
"inLibMsgConexion.SErrorFabricaSinRutaConfiguracion": ("La fábrica de conexiones no tiene una ruta de configuración.", "src/Lib/inLibMsgConexion.pas", "La fàbrica de connexions no té cap ruta de configuració.", "The connection factory has no configuration path.", "连接工厂没有配置路径。"),
"inLibMsgConexion.SErrorConexionNoAsignada": ("La conexión no está asignada.", "src/Lib/inLibMsgConexion.pas", "La connexió no està assignada.", "The connection has not been assigned.", "尚未分配连接。"),
"inLibMsgConexion.SErrorSSLMySQLNoSoportado": ("El modo SSL %s no está soportado de forma segura por el adaptador MariaDB/MySQL actual.", "src/Lib/inLibMsgConexion.pas", "El mode SSL %s no és compatible de manera segura amb l'adaptador MariaDB/MySQL actual.", "SSL mode %s is not securely supported by the current MariaDB/MySQL adapter.", "当前 MariaDB/MySQL 适配器无法安全支持 SSL 模式 %s。"),
"inLibMsgConexion.SErrorSSLPostgreSQLVerificacionCompletaNoDisponible": ("La verificación SSL completa de PostgreSQL requiere SecureBridge y no está disponible en el adaptador actual.", "src/Lib/inLibMsgConexion.pas", "La verificació SSL completa de PostgreSQL requereix SecureBridge i no està disponible a l'adaptador actual.", "Full PostgreSQL SSL verification requires SecureBridge and is not available in the current adapter.", "PostgreSQL 完整 SSL 验证需要 SecureBridge，当前适配器不支持此功能。"),
"inLibMsgConexion.SErrorConsultaCampoDesconocido": ("La consulta contiene un campo desconocido.", "src/Lib/inLibMsgConexion.pas", "La consulta conté un camp desconegut.", "The query contains an unknown field.", "查询包含未知字段。"),
"inLibMsgConexion.SErrorConsultaTablaNoExiste": ("La tabla consultada no existe en la base de datos.", "src/Lib/inLibMsgConexion.pas", "La taula consultada no existeix a la base de dades.", "The queried table does not exist in the database.", "查询的表在数据库中不存在。"),
"inLibMsgConexion.SErrorConsultaTablaYaExiste": ("La tabla o vista ya existe en la base de datos.", "src/Lib/inLibMsgConexion.pas", "La taula o vista ja existeix a la base de dades.", "The table or view already exists in the database.", "该表或视图已存在于数据库中。"),
"inLibMsgConexion.SErrorConsultaProcedimientoYaExiste": ("El procedimiento o función ya existe en la base de datos.", "src/Lib/inLibMsgConexion.pas", "El procediment o funció ja existeix a la base de dades.", "The procedure or function already exists in the database.", "该过程或函数已存在于数据库中。"),
"inLibMsgConexion.SErrorConexionServidorMotor": ("No se puede conectar al servidor de base de datos. Compruebe la red y el puerto.", "src/Lib/inLibMsgConexion.pas", "No es pot connectar al servidor de base de dades. Comproveu la xarxa i el port.", "Cannot connect to the database server. Check the network and port.", "无法连接到数据库服务器。请检查网络和端口。"),
"inLibMsgConexion.SErrorConexionPerdidaMotor": ("La conexión con el servidor de base de datos se ha perdido.", "src/Lib/inLibMsgConexion.pas", "S'ha perdut la connexió amb el servidor de base de dades.", "The connection to the database server has been lost.", "与数据库服务器的连接已丢失。"),
"inLibMsgConexion.SErrorConexionMotorSinDetalle": ("Se produjo un error en la base de datos (código %d).", "src/Lib/inLibMsgConexion.pas", "S'ha produït un error a la base de dades (codi %d).", "A database error occurred (code %d).", "发生数据库错误（代码 %d）。"),
"inLibMsgConexion.SDetalleErrorMotorBBDD": (" Detalle %s (%d): %s", "src/Lib/inLibMsgConexion.pas", " Detall %s (%d): %s", " Detail %s (%d): %s", " 详细信息 %s（%d）：%s"),
"inLibMsgConfiguracion.SErrorGuardarPreferenciasInicioSesion": ("El inicio de sesión es correcto, pero no se pudieron guardar todas las preferencias de acceso.\r\n\r\nLa sesión continuará.\r\n\r\n%s", "src/Lib/inLibMsgConfiguracion.pas", "L'inici de sessió és correcte, però no s'han pogut desar totes les preferències d'accés.\r\n\r\nLa sessió continuarà.\r\n\r\n%s", "Sign-in succeeded, but not all access preferences could be saved.\r\n\r\nThe session will continue.\r\n\r\n%s", "登录成功，但无法保存所有访问首选项。\r\n\r\n会话将继续。\r\n\r\n%s"),
"inLibMsgConfiguracion.SErrorPrepararNuevoEquipo": ("No se pudo restablecer la contraseña de acceso:\r\n%s", "src/Lib/inLibMsgConfiguracion.pas", "No s'ha pogut restablir la contrasenya d'accés:\r\n%s", "The access password could not be reset:\r\n%s", "无法重置访问密码：\r\n%s"),
"inLibMsgConfiguracion.SErrorGuardarInicioTrasNuevoEquipo": ("La contraseña ya se cambió, pero no se pudieron guardar todas las preferencias de inicio.\r\n\r\nPuede continuar e iniciar sesión con la contraseña nueva.\r\n\r\n%s", "src/Lib/inLibMsgConfiguracion.pas", "La contrasenya ja s'ha canviat, però no s'han pogut desar totes les preferències d'inici.\r\n\r\nPodeu continuar i iniciar sessió amb la contrasenya nova.\r\n\r\n%s", "The password has been changed, but not all sign-in preferences could be saved.\r\n\r\nYou can continue and sign in with the new password.\r\n\r\n%s", "密码已更改，但无法保存所有登录首选项。\r\n\r\n您可以继续使用新密码登录。\r\n\r\n%s"),
"inLibMsgConfiguracion.SErrorCompletarNuevoEquipoPendiente": ("La contraseña ya se cambió, pero no se pudo retirar la marca de primera ejecución.\r\n\r\nPuede continuar e iniciar sesión con la contraseña nueva.\r\n\r\n%s", "src/Lib/inLibMsgConfiguracion.pas", "La contrasenya ja s'ha canviat, però no s'ha pogut retirar la marca de primera execució.\r\n\r\nPodeu continuar i iniciar sessió amb la contrasenya nova.\r\n\r\n%s", "The password has been changed, but the first-run flag could not be cleared.\r\n\r\nYou can continue and sign in with the new password.\r\n\r\n%s", "密码已更改，但无法清除首次运行标记。\r\n\r\n您可以继续使用新密码登录。\r\n\r\n%s"),
"inLibMsgConfiguracion.SErrorOrdenParametrosNuevoEquipo": ("En el arranque de mantenimiento, el perfil INI debe ser el primer argumento de la aplicación.", "src/Lib/inLibMsgConfiguracion.pas", "En l'arrencada de manteniment, el perfil INI ha de ser el primer argument de l'aplicació.", "When starting in maintenance mode, the INI profile must be the application's first argument.", "以维护模式启动时，INI 配置文件必须是应用程序的第一个参数。"),
"inLibMsgConfiguracion.SErrorGuardarContrasenaUsuario": ("No se pudo guardar la contraseña con la protección de Windows.\r\n\r\nSe desactivarán \"Recordar contraseña\" y el arranque automático.\r\n\r\n%s", "src/Lib/inLibMsgConfiguracion.pas", "No s'ha pogut desar la contrasenya amb la protecció de Windows.\r\n\r\nEs desactivaran \"Recordar contrasenya\" i l'arrencada automàtica.\r\n\r\n%s", "The password could not be saved using Windows protection.\r\n\r\n\"Remember password\" and automatic start-up will be disabled.\r\n\r\n%s", "无法使用 Windows 保护保存密码。\r\n\r\n将禁用“记住密码”和自动启动。\r\n\r\n%s"),
"inLibMsgConfiguracion.SErrorGuardarContrasenaUsuarioNoRetirada": ("No se pudo guardar la contraseña exclusivamente con la protección de Windows ni retirar la credencial anterior.\r\n\r\n\"Recordar contraseña\" seguirá marcado para no ocultar que aún puede haber una credencial almacenada; el arranque automático se desactivará.\r\n\r\n%s\r\n%s", "src/Lib/inLibMsgConfiguracion.pas", "No s'ha pogut desar la contrasenya exclusivament amb la protecció de Windows ni retirar la credencial anterior.\r\n\r\n\"Recordar contrasenya\" continuarà marcat per no ocultar que encara hi pot haver una credencial emmagatzemada; l'arrencada automàtica es desactivarà.\r\n\r\n%s\r\n%s", "The password could not be saved using Windows protection alone, and the previous credential could not be removed.\r\n\r\n\"Remember password\" will remain selected so that a potentially stored credential is not hidden; automatic start-up will be disabled.\r\n\r\n%s\r\n%s", "无法仅使用 Windows 保护保存密码，也无法删除以前的凭据。\r\n\r\n“记住密码”将保持选中，以免隐藏可能仍存储的凭据；自动启动将被禁用。\r\n\r\n%s\r\n%s"),
"inLibMsgConfiguracion.SErrorEliminarContrasenaUsuario": ("No se pudo retirar la contraseña recordada.\r\n\r\nLa opción seguirá activada para no ocultar que la credencial aún puede estar almacenada.\r\n\r\n%s", "src/Lib/inLibMsgConfiguracion.pas", "No s'ha pogut retirar la contrasenya recordada.\r\n\r\nL'opció continuarà activada per no ocultar que la credencial encara pot estar emmagatzemada.\r\n\r\n%s", "The remembered password could not be removed.\r\n\r\nThe option will remain enabled so that a potentially stored credential is not hidden.\r\n\r\n%s", "无法删除已记住的密码。\r\n\r\n该选项将保持启用，以免隐藏可能仍存储的凭据。\r\n\r\n%s"),
"inLibMsgConfiguracion.SProgresoGuardandoCopiaTextoPlano": ("Guardando copia en texto plano", "src/Lib/inLibMsgConfiguracion.pas", "Desant la còpia en text pla", "Saving plain-text backup", "正在保存纯文本备份"),
"inLibMsgConfiguracion.SProgresoComprimiendoCopiaZip": ("Comprimiendo copia en ZIP", "src/Lib/inLibMsgConfiguracion.pas", "Comprimint la còpia en ZIP", "Compressing backup into ZIP", "正在将备份压缩为 ZIP"),
"inLibMsgConfiguracion.SProgresoComprimiendoCifrandoCopia": ("Comprimiendo ZIP y cifrando copia", "src/Lib/inLibMsgConfiguracion.pas", "Comprimint en ZIP i xifrant la còpia", "Compressing into ZIP and encrypting backup", "正在压缩为 ZIP 并加密备份"),
"inLibMsgConfiguracion.SErrorConexionCopiaNoDisponible": ("No hay una conexión disponible para la copia de seguridad.", "src/Lib/inLibMsgConfiguracion.pas", "No hi ha cap connexió disponible per a la còpia de seguretat.", "No connection is available for the backup.", "没有可用于备份的连接。"),
"inLibMsgConfiguracion.SErrorFormatoCreacionCopiaNoPermitido": ("El formato elegido para la copia de seguridad no está permitido.", "src/Lib/inLibMsgConfiguracion.pas", "El format triat per a la còpia de seguretat no està permès.", "The selected backup format is not permitted.", "不允许使用所选的备份格式。"),
"inLibMsgConfiguracion.SErrorFormatoCopiaNoCompatible": ("El formato de la copia no es compatible.", "src/Lib/inLibMsgConfiguracion.pas", "El format de la còpia no és compatible.", "The backup format is not compatible.", "备份格式不兼容。"),
"inLibMsgConfiguracion.SErrorSintaxisComandoCopiaSeguridad": ("Uso: fzam.exe [perfil.ini] /copiaseguridad \"<ruta>.crypt\".", "src/Lib/inLibMsgConfiguracion.pas", "Ús: fzam.exe [perfil.ini] /copiaseguridad \"<ruta>.crypt\".", "Usage: fzam.exe [profile.ini] /copiaseguridad \"<path>.crypt\".", "用法：fzam.exe [配置文件.ini] /copiaseguridad \"<路径>.crypt\"。"),
"inLibMsgConfiguracion.SErrorSintaxisComandoImprimirFacturas": ("Uso: fzam.exe /imprimirfacturas \"SERIE\\NUMERO, SERIE\\NUMERO\" [\"Formato\"] \"C:\\destino\". Si se omite el formato o se pasa \"\", se usa Predeterminado.", "src/Lib/inLibMsgConfiguracion.pas", "Ús: fzam.exe /imprimirfacturas \"SERIE\\NUMERO, SERIE\\NUMERO\" [\"Format\"] \"C:\\destinació\". Si s'omet el format o es passa \"\", s'utilitza Predeterminado.", "Usage: fzam.exe /imprimirfacturas \"SERIE\\NUMERO, SERIE\\NUMERO\" [\"Format\"] \"C:\\destination\". If the format is omitted or \"\" is passed, Predeterminado is used.", "用法：fzam.exe /imprimirfacturas \"SERIE\\NUMERO, SERIE\\NUMERO\" [\"格式\"] \"C:\\目标目录\"。如果省略格式或传入 \"\"，则使用 Predeterminado。"),
"inLibMsgConfiguracion.SAyudaComandos": ("Factuzam - opciones de ejecución\r\n\r\n1. Aplicación interactiva\r\n   fzam.exe [perfil.ini]\r\n   Abre Factuzam. El nombre simple del perfil .ini es opcional.\r\n\r\n2. Copia de seguridad cifrada\r\n   %s\r\n   Genera SQL, lo comprime en ZIP y cifra el resultado con la contraseña de la conexión.\r\n   La plantilla admite DIASEMANA, DIAMES, MES, AÑO, {ANO} y CLAVE. Sobrescribe el destino.\r\n   No se admite la contraseña como argumento.\r\n\r\n3. Impresión de facturas en PDF\r\n   %s\r\n   Acepta una o varias referencias y un formato opcional. Solicita una sesión autenticada.\r\n\r\n4. Ayuda\r\n   fzam.exe /?\r\n   fzam.exe /help\r\n   Muestra este texto en la consola y termina con código 0.\r\n\r\nEn línea de comandos, la copia siempre se genera como ZIP cifrado (.crypt). SQL y ZIP sin cifrar solo están disponibles desde el menú para administradores.", "src/Lib/inLibMsgConfiguracion.pas", "Factuzam - opcions d'execució\r\n\r\n1. Aplicació interactiva\r\n   fzam.exe [perfil.ini]\r\n   Obre Factuzam. El nom simple del perfil .ini és opcional.\r\n\r\n2. Còpia de seguretat xifrada\r\n   %s\r\n   Genera SQL, el comprimeix en ZIP i xifra el resultat amb la contrasenya de la connexió.\r\n   La plantilla admet DIASEMANA, DIAMES, MES, AÑO, {ANO} i CLAVE. Sobreescriu la destinació.\r\n   No s'admet la contrasenya com a argument.\r\n\r\n3. Impressió de factures en PDF\r\n   %s\r\n   Accepta una o diverses referències i un format opcional. Requereix una sessió autenticada.\r\n\r\n4. Ajuda\r\n   fzam.exe /?\r\n   fzam.exe /help\r\n   Mostra aquest text a la consola i acaba amb el codi 0.\r\n\r\nA la línia d'ordres, la còpia sempre es genera com a ZIP xifrat (.crypt). SQL i ZIP sense xifrar només estan disponibles al menú per a administradors.", "Factuzam - command-line options\r\n\r\n1. Interactive application\r\n   fzam.exe [profile.ini]\r\n   Opens Factuzam. A simple .ini profile name is optional.\r\n\r\n2. Encrypted backup\r\n   %s\r\n   Generates SQL, compresses it into ZIP and encrypts the result with the connection password.\r\n   The template accepts DIASEMANA, DIAMES, MES, AÑO, {ANO} and CLAVE. It overwrites the destination.\r\n   The password cannot be supplied as an argument.\r\n\r\n3. Print invoices to PDF\r\n   %s\r\n   Accepts one or more references and an optional format. Requires an authenticated session.\r\n\r\n4. Help\r\n   fzam.exe /?\r\n   fzam.exe /help\r\n   Displays this text in the console and exits with code 0.\r\n\r\nFrom the command line, the backup is always generated as an encrypted ZIP (.crypt). Unencrypted SQL and ZIP are only available from the administrators' menu.", "Factuzam - 命令行选项\r\n\r\n1. 交互式应用程序\r\n   fzam.exe [配置文件.ini]\r\n   打开 Factuzam。可以选择仅指定 .ini 配置文件名。\r\n\r\n2. 加密备份\r\n   %s\r\n   生成 SQL，将其压缩为 ZIP，并使用连接密码加密结果。\r\n   模板支持 DIASEMANA、DIAMES、MES、AÑO、{ANO} 和 CLAVE。目标文件将被覆盖。\r\n   不允许将密码作为参数传入。\r\n\r\n3. 将发票打印为 PDF\r\n   %s\r\n   支持一个或多个引用以及可选格式。需要经过身份验证的会话。\r\n\r\n4. 帮助\r\n   fzam.exe /?\r\n   fzam.exe /help\r\n   在控制台中显示此文本，并以代码 0 退出。\r\n\r\n通过命令行执行时，备份始终生成为加密 ZIP（.crypt）。未加密的 SQL 和 ZIP 仅可从管理员菜单中生成。"),
"inLibMsgConfiguracion.SErrorRutaComandoCopiaSeguridad": ("La ruta de la copia de seguridad no es válida.", "src/Lib/inLibMsgConfiguracion.pas", "La ruta de la còpia de seguretat no és vàlida.", "The backup path is invalid.", "备份路径无效。"),
"inLibMsgConfiguracion.SErrorExtensionComandoCopiaSeguridad": ("El destino de la copia debe tener extensión .crypt.", "src/Lib/inLibMsgConfiguracion.pas", "La destinació de la còpia ha de tenir l'extensió .crypt.", "The backup destination must have a .crypt extension.", "备份目标必须使用 .crypt 扩展名。"),
"inLibMsgConfiguracion.SErrorClaveComandoCopiaSeguridad": ("La contraseña configurada para la conexión de la BBDD no es válida.", "src/Lib/inLibMsgConfiguracion.pas", "La contrasenya configurada per a la connexió de la base de dades no és vàlida.", "The password configured for the database connection is invalid.", "为数据库连接配置的密码无效。"),
"inLibMsgConfiguracion.SErrorConexionComandoCopiaSeguridad": ("No se pudo preparar la conexión para la copia: %s", "src/Lib/inLibMsgConfiguracion.pas", "No s'ha pogut preparar la connexió per a la còpia: %s", "The connection for the backup could not be prepared: %s", "无法为备份准备连接：%s"),
"inLibMsgConfiguracion.SErrorInesperadoComandoCopiaSeguridad": ("Error inesperado al preparar la copia de seguridad: %s", "src/Lib/inLibMsgConfiguracion.pas", "Error inesperat en preparar la còpia de seguretat: %s", "Unexpected error while preparing the backup: %s", "准备备份时发生意外错误：%s"),
"inLibMsgConfiguracion.SErrorPublicarComandoCopiaSeguridad": ("No se pudo guardar la copia en su destino: %s", "src/Lib/inLibMsgConfiguracion.pas", "No s'ha pogut desar la còpia a la destinació: %s", "The backup could not be saved to its destination: %s", "无法将备份保存到目标位置：%s"),
"inLibMsgConfiguracion.SErrorFormatoComandoCopiaSeguridad": ("El archivo temporal no contiene una copia cifrada válida.", "src/Lib/inLibMsgConfiguracion.pas", "El fitxer temporal no conté una còpia xifrada vàlida.", "The temporary file does not contain a valid encrypted backup.", "临时文件不包含有效的加密备份。"),
"inLibMsgConfiguracion.SInfoComandoCopiaSeguridadInicio": ("Inicio de copia de seguridad por línea de comandos.", "src/Lib/inLibMsgConfiguracion.pas", "Inici de còpia de seguretat per línia d'ordres.", "Command-line backup started.", "已开始命令行备份。"),
"inLibMsgConfiguracion.SInfoComandoCopiaSeguridadParametrosValidados": ("Parámetros de la copia validados correctamente.", "src/Lib/inLibMsgConfiguracion.pas", "Paràmetres de la còpia validats correctament.", "Backup parameters validated successfully.", "备份参数验证成功。"),
"inLibMsgConfiguracion.SInfoComandoCopiaSeguridadConexion": ("Preparando la conexión configurada para la copia.", "src/Lib/inLibMsgConfiguracion.pas", "Preparant la connexió configurada per a la còpia.", "Preparing the configured connection for the backup.", "正在为备份准备已配置的连接。"),
"inLibMsgConfiguracion.SInfoComandoCopiaSeguridadConexionPreparada": ("Conexión preparada: servidor %s; base de datos %s.", "src/Lib/inLibMsgConfiguracion.pas", "Connexió preparada: servidor %s; base de dades %s.", "Connection ready: server %s; database %s.", "连接已准备：服务器 %s；数据库 %s。"),
"inLibMsgConfiguracion.SInfoComandoCopiaSeguridadDestino": ("Destino de la copia: %s", "src/Lib/inLibMsgConfiguracion.pas", "Destinació de la còpia: %s", "Backup destination: %s", "备份目标：%s"),
"inLibMsgConfiguracion.SInfoComandoCopiaSeguridadGeneracion": ("Generando el SQL, comprimiéndolo en ZIP y cifrándolo.", "src/Lib/inLibMsgConfiguracion.pas", "Generant l'SQL, comprimint-lo en ZIP i xifrant-lo.", "Generating the SQL, compressing it into ZIP and encrypting it.", "正在生成 SQL、压缩为 ZIP 并进行加密。"),
"inLibMsgConfiguracion.SInfoComandoCopiaSeguridadPublicacion": ("Copia cifrada generada. Publicando el archivo de destino; si ya existe, se reemplazará.", "src/Lib/inLibMsgConfiguracion.pas", "Còpia xifrada generada. Publicant el fitxer de destinació; si ja existeix, se substituirà.", "Encrypted backup generated. Publishing the destination file; if it already exists, it will be replaced.", "加密备份已生成。正在发布目标文件；如果已存在，将被替换。"),
"inLibMsgConfiguracion.SInfoComandoCopiaSeguridadCompletado": ("Copia de seguridad completada: %s", "src/Lib/inLibMsgConfiguracion.pas", "Còpia de seguretat completada: %s", "Backup completed: %s", "备份已完成：%s"),
"inLibMsgConfiguracion.SErrorContrasenaUsuarioVacia": ("La contraseña nueva no puede estar vacía.", "src/Lib/inLibMsgConfiguracion.pas", "La contrasenya nova no pot estar buida.", "The new password cannot be empty.", "新密码不能为空。"),
"inLibMsgConfiguracion.SCaptionNuevaContrasenaUsuario": ("Nueva contraseña", "src/Lib/inLibMsgConfiguracion.pas", "Contrasenya nova", "New password", "新密码"),
"inLibMsgConfiguracion.SCaptionRepetirNuevaContrasenaUsuario": ("Repita la nueva contraseña", "src/Lib/inLibMsgConfiguracion.pas", "Repetiu la contrasenya nova", "Repeat new password", "再次输入新密码"),
"inLibMsgConfiguracion.SCaptionContinuarNuevaContrasena": ("&Continuar", "src/Lib/inLibMsgConfiguracion.pas", "&Continuar", "&Continue", "继续(&C)"),
"inLibMsgConfiguracion.SCaptionFiltroCopiasZip": ("Copias ZIP", "src/Lib/inLibMsgConfiguracion.pas", "Còpies ZIP", "ZIP backups", "ZIP 备份"),
"inLibMsgConfiguracion.SCaptionFiltroArchivosTexto": ("Archivos de texto (*.txt)|*.txt|Todos los archivos (*.*)|*.*", "src/Lib/inLibMsgConfiguracion.pas", "Fitxers de text (*.txt)|*.txt|Tots els fitxers (*.*)|*.*", "Text files (*.txt)|*.txt|All files (*.*)|*.*", "文本文件 (*.txt)|*.txt|所有文件 (*.*)|*.*"),
"inLibMsgFacturas.SErrorFacturasFiltradasVacias": ("No hay facturas en el resultado filtrado.", "src/Lib/inLibMsgFacturas.pas", "No hi ha factures al resultat filtrat.", "There are no invoices in the filtered results.", "筛选结果中没有发票。"),
"inLibMsgFacturas.SErrorCambiosPendientesProcesarFiltradas": ("Guarde o cancele los cambios de la factura antes de procesar el resultado filtrado.", "src/Lib/inLibMsgFacturas.pas", "Deseu o cancel·leu els canvis de la factura abans de processar el resultat filtrat.", "Save or cancel the invoice changes before processing the filtered results.", "请先保存或取消发票更改，然后再处理筛选结果。"),
"inLibMsgFacturas.SErrorServicioLoteImpresionFacturas": ("No está disponible el servicio de impresión por lotes.", "src/Lib/inLibMsgFacturas.pas", "El servei d'impressió per lots no està disponible.", "The batch printing service is not available.", "批量打印服务不可用。"),
"inLibMsgFacturas.SErrorLoteImpresionFacturas": ("La impresión por lotes se detuvo tras enviar %d de %d facturas.\r\n%s", "src/Lib/inLibMsgFacturas.pas", "La impressió per lots s'ha aturat després d'enviar %d de %d factures.\r\n%s", "Batch printing stopped after sending %d of %d invoices.\r\n%s", "批量打印在发送 %d 张（共 %d 张）发票后停止。\r\n%s"),
"inLibMsgFacturas.SInfoLoteImpresionFacturas": ("Impresión por lotes finalizada.\r\nFacturas enviadas: %d.\r\nOmitidas por no estar consolidadas: %d.", "src/Lib/inLibMsgFacturas.pas", "Impressió per lots finalitzada.\r\nFactures enviades: %d.\r\nOmeses perquè no estan consolidades: %d.", "Batch printing completed.\r\nInvoices sent: %d.\r\nSkipped because they were not consolidated: %d.", "批量打印完成。\r\n已发送发票：%d。\r\n因未合并而跳过：%d。"),
"inLibMsgFacturas.SErrorGuardarTrabajoLote": ("No se pudo generar trabajo_lote.txt: %s", "src/Lib/inLibMsgFacturas.pas", "No s'ha pogut generar trabajo_lote.txt: %s", "trabajo_lote.txt could not be generated: %s", "无法生成 trabajo_lote.txt：%s"),
"inLibMsgFacturas.SInfoTrabajoLoteGuardado": ("Resultado guardado en:\r\n%s", "src/Lib/inLibMsgFacturas.pas", "Resultat desat a:\r\n%s", "Results saved to:\r\n%s", "结果已保存到：\r\n%s"),
"inLibMsgLogon.SErrorBaseDatosAutenticacionNoDisponible": ("La base de datos de autenticación no está disponible.", "src/Lib/inLibMsgLogon.pas", "La base de dades d'autenticació no està disponible.", "The authentication database is not available.", "身份验证数据库不可用。"),
"inLibMsgLogon.SResultadoCredencialesInvalidas": ("Las credenciales no son válidas.", "src/Lib/inLibMsgLogon.pas", "Les credencials no són vàlides.", "The credentials are invalid.", "凭据无效。"),
"inLibMsgLogon.SResultadoAutenticacionCorrecta": ("Autenticación correcta.", "src/Lib/inLibMsgLogon.pas", "Autenticació correcta.", "Authentication successful.", "身份验证成功。"),
"inLibMsgLogon.SErrorUsuarioNuevoEquipoNoAutorizado": ("El usuario \"%s\" no existe, no está activo o no pertenece a un grupo administrador.", "src/Lib/inLibMsgLogon.pas", "L'usuari \"%s\" no existeix, no està actiu o no pertany a un grup administrador.", "User \"%s\" does not exist, is inactive or does not belong to an administrator group.", "用户“%s”不存在、未启用或不属于管理员组。"),
"inLibMsgLogon.SErrorContrasenaNuevoEquipoNoVerificada": ("No se pudo verificar la contraseña nueva del usuario \"%s\".", "src/Lib/inLibMsgLogon.pas", "No s'ha pogut verificar la contrasenya nova de l'usuari \"%s\".", "The new password for user \"%s\" could not be verified.", "无法验证用户“%s”的新密码。"),
"inLibMsgLogon.SErrorContrasenaNuevoEquipoDebeDiferirDemo": ("La contraseña nueva debe ser distinta de la contraseña inicial de la demo.", "src/Lib/inLibMsgLogon.pas", "La contrasenya nova ha de ser diferent de la contrasenya inicial de la demo.", "The new password must differ from the initial demo password.", "新密码必须与演示版初始密码不同。"),
"inLibMsgLogon.SAvisoNuevoEquipoDemoYaPreparado": ("La contraseña inicial de la demo ya había sido cambiada. Continúe con el inicio de sesión.", "src/Lib/inLibMsgLogon.pas", "La contrasenya inicial de la demo ja s'havia canviat. Continueu amb l'inici de sessió.", "The initial demo password has already been changed. Continue signing in.", "演示版初始密码已更改。请继续登录。"),
"inLibMsgSql.SErrorTextoSqlVacio": ("La sentencia SQL no puede estar vacía.", "src/Lib/inLibMsgSql.pas", "La sentència SQL no pot estar buida.", "The SQL statement cannot be empty.", "SQL 语句不能为空。"),
"inLibMsgSql.SErrorOrdenSqlVacio": ("Una consulta limitada debe tener una ordenación determinista.", "src/Lib/inLibMsgSql.pas", "Una consulta limitada ha de tenir una ordenació determinista.", "A limited query must have deterministic ordering.", "有限制的查询必须具有确定性排序。"),
"inLibMsgSql.SErrorCantidadLimiteSql": ("La cantidad de filas del límite SQL debe ser mayor que cero.", "src/Lib/inLibMsgSql.pas", "La quantitat de files del límit SQL ha de ser superior a zero.", "The SQL row limit must be greater than zero.", "SQL 行数限制必须大于零。"),
"inLibMsgSql.SErrorDesplazamientoSql": ("El desplazamiento del límite SQL no puede ser negativo.", "src/Lib/inLibMsgSql.pas", "El desplaçament del límit SQL no pot ser negatiu.", "The SQL limit offset cannot be negative.", "SQL 限制偏移量不能为负数。"),
"inLibMsgSql.SErrorNombreSqlVacio": ("El nombre SQL no puede estar vacío.", "src/Lib/inLibMsgSql.pas", "El nom SQL no pot estar buit.", "The SQL name cannot be empty.", "SQL 名称不能为空。"),
"inLibMsgSql.SErrorLongitudRellenoSql": ("La longitud del relleno SQL debe ser mayor que cero.", "src/Lib/inLibMsgSql.pas", "La longitud de l'emplenament SQL ha de ser superior a zero.", "The SQL padding length must be greater than zero.", "SQL 填充长度必须大于零。"),
"inLibMsgSql.SErrorAgregacionDistinctSqlNoSoportada": ("La agregación de texto DISTINCT no está disponible en %s.", "src/Lib/inLibMsgSql.pas", "L'agregació de text DISTINCT no està disponible a %s.", "DISTINCT text aggregation is not available in %s.", "%s 不支持 DISTINCT 文本聚合。"),
"inLibMsgSql.SErrorVarianteSqlMotorNoDisponible": ("La operación SQL %s no tiene una variante para %s.", "src/Lib/inLibMsgSql.pas", "L'operació SQL %s no té cap variant per a %s.", "SQL operation %s has no variant for %s.", "SQL 操作 %s 没有适用于 %s 的变体。"),
"inLibMsgSql.SErrorMotorConexionPendiente": ("El motor %s está previsto por el contrato, pero su adaptador de conexión todavía no está implementado.", "src/Lib/inLibMsgSql.pas", "El motor %s està previst pel contracte, però el seu adaptador de connexió encara no està implementat.", "Engine %s is covered by the contract, but its connection adapter has not yet been implemented.", "契约已涵盖引擎 %s，但其连接适配器尚未实现。"),
"inLibMsgSqlSeguro.SErrorDialectoSqlNoAsignado": ("El dialecto SQL no está configurado.", "src/Lib/inLibMsgSqlSeguro.pas", "El dialecte SQL no està configurat.", "The SQL dialect is not configured.", "尚未配置 SQL 方言。"),
"inLibMsgSqlSeguro.SIdentificadorSqlNoPermitido": ("El identificador SQL \"%s\" no pertenece a la lista blanca.", "src/Lib/inLibMsgSqlSeguro.pas", "L'identificador SQL \"%s\" no pertany a la llista blanca.", "SQL identifier \"%s\" is not on the allowlist.", "SQL 标识符“%s”不在允许列表中。"),
"inLibMsgSqlSeguro.SIdentificadorSqlInvalido": ("El identificador SQL \"%s\" contiene caracteres no válidos.", "src/Lib/inLibMsgSqlSeguro.pas", "L'identificador SQL \"%s\" conté caràcters no vàlids.", "SQL identifier \"%s\" contains invalid characters.", "SQL 标识符“%s”包含无效字符。"),
"inMtoAppParam.Parametros.appErroresUrl.Descripcion": ("URL directa para enviar errores al desarrollador", "src/Lib/inLibAppParam.pas", "URL directa per enviar errors al desenvolupador", "Direct URL for sending errors to the developer", "用于向开发人员发送错误的直接 URL"),
"inMtoCajaParam.Parametros.vgerAvisoHuecosNumeracion.Descripcion": ("Avisar de huecos en la numeración de ventas", "src/Caja/Lib/inLibCajaParam.pas", "Avisar de buits a la numeració de vendes", "Warn about gaps in sales numbering", "销售编号出现空缺时发出警告"),
"inMtoCajaParam.Parametros.vgerArqueoEditarCambio.Descripcion": ("Permitir editar el cambio dejado para la siguiente jornada", "src/Caja/Lib/inLibCajaParam.pas", "Permetre editar el canvi deixat per a la jornada següent", "Allow editing the cash float left for the next trading day", "允许编辑留给下一营业日的备用金"),
"inMtoCajaParam.Parametros.vgerArqueoEmitirJustificante.Descripcion": ("Emitir justificante al grabar el cierre", "src/Caja/Lib/inLibCajaParam.pas", "Emetre un justificant en desar el tancament", "Issue a closing receipt when saving the till closing", "保存结账时出具凭证"),
