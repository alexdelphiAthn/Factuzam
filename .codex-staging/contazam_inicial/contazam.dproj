<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{E2B38EAA-A3B1-4D8E-9F6F-7C24D570C8D1}</ProjectGuid>
    <MainSource>contazam.dpr</MainSource>
    <Base>True</Base>
    <Config Condition="'$(Config)'==''">Debug</Config>
    <ProjectName Condition="'$(ProjectName)'==''">contazam</ProjectName>
    <TargetedPlatforms>1</TargetedPlatforms>
    <AppType>Application</AppType>
    <FrameworkType>VCL</FrameworkType>
    <ProjectVersion>20.4</ProjectVersion>
    <Platform Condition="'$(Platform)'==''">Win32</Platform>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Base)'!=''">
    <DCC_Namespace>Winapi;System.Win;Data.Win;Datasnap.Win;Web.Win;Soap.Win;Xml.Win;Vcl;Vcl.Imaging;System;Xml;Data;Datasnap;Web;Soap;$(DCC_Namespace)</DCC_Namespace>
    <DCC_UnitSearchPath>src\Lib;src\Core;src\Forms;src\DataModules;C:\Program Files (x86)\Devart\UniDAC for RAD Studio 13\Lib\Win32;C:\Program Files (x86)\DevExpress\VCL\Library\RS37;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
    <DCC_ExeOutput>.\build\bin\$(Config)</DCC_ExeOutput>
    <DCC_DcuOutput>.\build\dcus\$(Config)</DCC_DcuOutput>
    <DCC_ImageBase>00400000</DCC_ImageBase>
    <SanitizedProjectName>Contazam</SanitizedProjectName>
    <VerInfo_Locale>3082</VerInfo_Locale>
    <VerInfo_IncludeVerInfo>true</VerInfo_IncludeVerInfo>
    <VerInfo_Keys>
      CompanyName=Contazam;FileDescription=Contabilidad multiempresa;
      FileVersion=1.0.0.0;InternalName=contazam;
      LegalCopyright=Copyright (c) Alejandro Laorden Hidalgo;
      OriginalFilename=contazam.exe;ProductName=Contazam;
      ProductVersion=1.0.0.0
    </VerInfo_Keys>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Config)'=='Release'">
    <DCC_Define>RELEASE;$(DCC_Define)</DCC_Define>
    <DCC_DebugInformation>0</DCC_DebugInformation>
    <DCC_LocalDebugSymbols>false</DCC_LocalDebugSymbols>
    <DCC_SymbolReferenceInfo>0</DCC_SymbolReferenceInfo>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Config)'=='Debug'">
    <DCC_Define>DEBUG;$(DCC_Define)</DCC_Define>
    <DCC_Optimize>false</DCC_Optimize>
    <DCC_GenerateStackFrames>true</DCC_GenerateStackFrames>
    <DCC_RangeChecking>true</DCC_RangeChecking>
    <DCC_IntegerOverflowCheck>true</DCC_IntegerOverflowCheck>
  </PropertyGroup>
  <ItemGroup>
    <DelphiCompile Include="$(MainSource)">
      <MainSource>MainSource</MainSource>
    </DelphiCompile>
    <BuildConfiguration Include="Base">
      <Key>Base</Key>
    </BuildConfiguration>
    <BuildConfiguration Include="Release">
      <Key>Release</Key>
      <CfgParent>Base</CfgParent>
    </BuildConfiguration>
    <BuildConfiguration Include="Debug">
      <Key>Debug</Key>
      <CfgParent>Base</CfgParent>
    </BuildConfiguration>
  </ItemGroup>
  <ProjectExtensions>
    <Borland.Personality>Delphi.Personality.12</Borland.Personality>
    <Borland.ProjectType>Application</Borland.ProjectType>
    <BorlandProject>
      <Delphi.Personality>
        <Source>
          <Source Name="MainSource">contazam.dpr</Source>
        </Source>
      </Delphi.Personality>
      <Platforms>
        <Platform value="Win32">True</Platform>
        <Platform value="Win64">False</Platform>
      </Platforms>
    </BorlandProject>
  </ProjectExtensions>
  <Import
    Project="$(BDS)\Bin\CodeGear.Delphi.Targets"
    Condition="Exists('$(BDS)\Bin\CodeGear.Delphi.Targets')"/>
</Project>
