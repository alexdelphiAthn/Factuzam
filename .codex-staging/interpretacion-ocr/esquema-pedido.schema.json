{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pedido normalizado para Factuzam",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "document_type": {
      "type": "string",
      "enum": ["preorder", "order", "invoice", "unknown"]
    },
    "supplier": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "tax_id": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "address": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "phone": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
      },
      "required": ["name", "tax_id", "address", "phone"]
    },
    "bill_to": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "tax_id": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "address": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "customer_code": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
      },
      "required": ["name", "tax_id", "address", "customer_code"]
    },
    "ship_to": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "address": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "ship_to_code": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
      },
      "required": ["name", "address", "ship_to_code"]
    },
    "order": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "number": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "date_raw": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "date_iso": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "ship_date_raw": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "ship_date_iso": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "last_ship_date_raw": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "last_ship_date_iso": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "terms": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "customer_purchase_order": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "order_type": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "sales_person": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
      },
      "required": ["number", "date_raw", "date_iso", "ship_date_raw", "ship_date_iso", "last_ship_date_raw", "last_ship_date_iso", "terms", "customer_purchase_order", "order_type", "sales_person"]
    },
    "size_columns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "supplier_size": { "type": "string" },
          "eu_size": { "type": "string" }
        },
        "required": ["supplier_size", "eu_size"]
      }
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "model_raw": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "model": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "description": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "color": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "quantities": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "size": { "type": "string" },
                "quantity": { "type": "integer" }
              },
              "required": ["size", "quantity"]
            }
          },
          "quantity": { "anyOf": [{ "type": "integer" }, { "type": "null" }] },
          "rrp": { "anyOf": [{ "type": "number" }, { "type": "null" }] },
          "wholesale_unit_price": { "anyOf": [{ "type": "number" }, { "type": "null" }] },
          "line_amount": { "anyOf": [{ "type": "number" }, { "type": "null" }] },
          "currency": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
        },
        "required": ["model_raw", "model", "description", "color", "quantities", "quantity", "rrp", "wholesale_unit_price", "line_amount", "currency"]
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "quantity": { "anyOf": [{ "type": "integer" }, { "type": "null" }] },
        "amount": { "anyOf": [{ "type": "number" }, { "type": "null" }] },
        "currency": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
      },
      "required": ["quantity", "amount", "currency"]
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "line_quantities_match": { "type": "boolean" },
        "line_amounts_match": { "type": "boolean" },
        "document_totals_match": { "type": "boolean" },
        "requires_review": { "type": "boolean" },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["line_quantities_match", "line_amounts_match", "document_totals_match", "requires_review", "warnings"]
    }
  },
  "required": ["document_type", "supplier", "bill_to", "ship_to", "order", "size_columns", "lines", "totals", "validation"]
}

