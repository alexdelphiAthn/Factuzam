# Plantilla de referencia. El servidor lee el entorno del proceso; no carga
# este archivo automáticamente. No lo copies a un archivo versionado ni pongas
# aquí credenciales reales.

# MariaDB: usuario exclusivo de solo lectura. EXECUTE es necesario para
# PRC_GET_MOV_VENTAS_ART; no conceder INSERT, UPDATE, DELETE, DDL ni GRANT.
FACTUZAM_DB_HOST=127.0.0.1
FACTUZAM_DB_PORT=3306
FACTUZAM_DB_NAME=factuzam_demo
FACTUZAM_DB_USER=factuzam_mcp_ro
# Elige UNA fuente: contraseña de proceso o referencia al Administrador de
# credenciales de Windows. No configures ambas.
FACTUZAM_DB_PASSWORD=
FACTUZAM_DB_CREDENTIAL_TARGET=
# Ruta a la CA para validar TLS de MariaDB; déjala vacía solo en una conexión
# local de confianza.
FACTUZAM_DB_SSL_CA=
FACTUZAM_DB_CONNECT_TIMEOUT=5
FACTUZAM_DB_READ_TIMEOUT=30
FACTUZAM_DB_WRITE_TIMEOUT=30

# Identidad lógica y permisos del proceso MCP. Listas separadas por comas.
# Vacío significa denegar. Scopes conocidos:
#   stock:read, ventas:read, ventas:create, caja.verCoste
FACTUZAM_MCP_PRINCIPAL=
FACTUZAM_MCP_SCOPES=
FACTUZAM_MCP_TRANSPORTE=stdio

# Límites de negocio. Para las herramientas de venta, las tres listas son
# obligatorias. No uses comodines.
FACTUZAM_EMPRESAS_PERMITIDAS=
FACTUZAM_ALMACENES_PERMITIDOS=
FACTUZAM_CAJAS_PERMITIDAS=

# Límites defensivos para consultas e informes.
FACTUZAM_MCP_MAX_REPORT_DAYS=366
FACTUZAM_MCP_MAX_STOCK_PAGE_SIZE=500
FACTUZAM_MCP_MAX_STOCK_OFFSET=50000
FACTUZAM_MCP_MAX_REPORT_ROWS=5000
FACTUZAM_MCP_MAX_PURCHASE_LOOKBACK_DAYS=3650

# Escritura desactivada por defecto. Solo "SI" la habilita y aun así requiere
# ventas:create, allowlists, confirmación e idempotencia.
FACTUZAM_VENTAS_HABILITADAS=NO

# Puente externo al dominio Delphi. Este repositorio no incluye ese servicio.
# Usa HTTPS o loopback; el token es secreto y debe permanecer vacío aquí.
FACTUZAM_VENTAS_BRIDGE_URL=
FACTUZAM_VENTAS_BRIDGE_TOKEN=
FACTUZAM_VENTAS_BRIDGE_TIMEOUT_SECONDS=10
FACTUZAM_VENTAS_BRIDGE_MAX_RESPONSE_BYTES=1048576
