<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{D03AC551-653B-4F1F-B104-8D675D6D8DA5}</ProjectGuid>
    <MainSource>CertApiWeb.dpr</MainSource>
    <Base>True</Base>
    <Config Condition="'$(Config)'==''">Debug</Config>
    <ProjectName Condition="'$(ProjectName)'==''">CertApiWeb</ProjectName>
    <TargetedPlatforms>1</TargetedPlatforms>
    <AppType>Application</AppType>
    <FrameworkType>VCL</FrameworkType>
    <ProjectVersion>20.3</ProjectVersion>
    <Platform Condition="'$(Platform)'==''">Win32</Platform>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Base)'!=''">
    <DCC_Namespace>Winapi;System.Win;Data.Win;Datasnap.Win;Web.Win;Soap.Win;Xml.Win;Vcl;System;Xml;Data;Datasnap;Web;Soap;$(DCC_Namespace)</DCC_Namespace>
    <DCC_UnitSearchPath>..\..\..\..\..\DelphiDcus\Win32\Release\CryptoLib4PascalPackage;..\..\..\..\..\DelphiDcus\Win32\Release\HashLib4PascalPackage;..\..\..\..\..\DelphiDcus\Win32\Release\SimpleBaseLib4PascalPackage;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
    <DCC_ExeOutput>..\bin</DCC_ExeOutput>
    <DCC_DcuOutput>.\dcu</DCC_DcuOutput>
    <DCC_ImageBase>00400000</DCC_ImageBase>
    <SanitizedProjectName>CertApiWeb</SanitizedProjectName>
    <VerInfo_Locale>3082</VerInfo_Locale>
    <VerInfo_IncludeVerInfo>true</VerInfo_IncludeVerInfo>
    <VerInfo_Keys>CompanyName=Factuzam;FileDescription=Generador de credenciales API;FileVersion=1.1.0.0;InternalName=CertApiWeb;LegalCopyright=Copyright (c) Alejandro Laorden Hidalgo;OriginalFilename=CertApiWeb.exe;ProductName=CertApiWeb;ProductVersion=1.1.0.0</VerInfo_Keys>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Config)'=='Release'">
    <DCC_Define>RELEASE;$(DCC_Define)</DCC_Define>
    <DCC_DebugInformation>0</DCC_DebugInformation>
    <DCC_LocalDebugSymbols>false</DCC_LocalDebugSymbols>
    <DCC_SymbolReferenceInfo>0</DCC_SymbolReferenceInfo>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Config)'=='Debug'">
    <DCC_Define>DEBUG;$(DCC_Define)</DCC_Define>
    <DCC_Optimize>false</DCC_Optimize>
    <DCC_GenerateStackFrames>true</DCC_GenerateStackFrames>
    <DCC_RangeChecking>true</DCC_RangeChecking>
    <DCC_IntegerOverflowCheck>true</DCC_IntegerOverflowCheck>
  </PropertyGroup>
  <ItemGroup>
    <DelphiCompile Include="$(MainSource)">
      <MainSource>MainSource</MainSource>
    </DelphiCompile>
    <DCCReference Include="UPrincipal.pas">
      <Form>frmPrincipal</Form>
    </DCCReference>
    <DCCReference Include="inLibClienteApi.pas"/>
    <DCCReference Include="inLibFirmaApi.pas"/>
    <DCCReference Include="inLibProteccionWindows.pas"/>
    <BuildConfiguration Include="Base">
      <Key>Base</Key>
    </BuildConfiguration>
    <BuildConfiguration Include="Release">
      <Key>Release</Key>
      <CfgParent>Base</CfgParent>
    </BuildConfiguration>
    <BuildConfiguration Include="Debug">
      <Key>Debug</Key>
      <CfgParent>Base</CfgParent>
    </BuildConfiguration>
  </ItemGroup>
  <ProjectExtensions>
    <Borland.Personality>Delphi.Personality.12</Borland.Personality>
    <BorlandProject>
      <Delphi.Personality>
        <Source>
          <Source Name="MainSource">CertApiWeb.dpr</Source>
        </Source>
      </Delphi.Personality>
      <Platforms>
        <Platform value="Win32">True</Platform>
        <Platform value="Win64">False</Platform>
      </Platforms>
    </BorlandProject>
    <ProjectFileVersion>12</ProjectFileVersion>
  </ProjectExtensions>
  <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets"
          Condition="Exists('$(BDS)\Bin\CodeGear.Delphi.Targets')"/>
</Project>
