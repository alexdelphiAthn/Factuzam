<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{4F3A1C7E-2B6D-4E9A-9C11-7A0F2D8B3E55}</ProjectGuid>
        <ProjectVersion>20.3</ProjectVersion>
        <FrameworkType>FMX</FrameworkType>
        <Base>True</Base>
        <Config Condition="'$(Config)'==''">Debug</Config>
        <Platform Condition="'$(Platform)'==''">Android64</Platform>
        <TargetedPlatforms>16</TargetedPlatforms>
        <AppType>Application</AppType>
        <MainSource>SubirFotosFmx.dpr</MainSource>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Base' or '$(Base)'!=''">
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="('$(Platform)'=='Win32' and '$(Base)'=='true') or '$(Base_Win32)'!=''">
        <Base_Win32>true</Base_Win32>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="('$(Platform)'=='Android64' and '$(Base)'=='true') or '$(Base_Android64)'!=''">
        <Base_Android64>true</Base_Android64>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Debug' or '$(Cfg_1)'!=''">
        <Cfg_1>true</Cfg_1>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Release' or '$(Cfg_2)'!=''">
        <Cfg_2>true</Cfg_2>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base)'!=''">
        <DCC_DcuOutput>.\$(Platform)\$(Config)</DCC_DcuOutput>
        <DCC_ExeOutput>.\$(Platform)\$(Config)</DCC_ExeOutput>
        <DCC_Namespace>System;Xml;Data;Datasnap;Web;Soap;Fmx;System.Win;Data.Win;$(DCC_Namespace)</DCC_Namespace>
        <SanitizedProjectName>SubirFotosFmx</SanitizedProjectName>
        <DCC_E>false</DCC_E>
        <DCC_N>false</DCC_N>
        <DCC_S>false</DCC_S>
        <DCC_F>false</DCC_F>
        <DCC_K>false</DCC_K>
        <VerInfo_Keys>CompanyName=Factuzam;FileDescription=Factuzam Fotos Nube;FileVersion=1.0.0.0;InternalName=;LegalCopyright=;LegalTrademarks=;OriginalFilename=;ProgramID=com.factuzam.fotosnube;ProductName=Factuzam Fotos Nube;ProductVersion=1.0.0.0;Comments=</VerInfo_Keys>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base_Win32)'!=''">
        <DCC_UsePackage>rtl;fmx;fmxase;fmxobj;xmlrtl;inet;$(DCC_UsePackage)</DCC_UsePackage>
        <DCC_Namespace>Winapi;System.Win;Data.Win;Datasnap.Win;Web.Win;Soap.Win;Xml.Win;$(DCC_Namespace)</DCC_Namespace>
        <BT_BuildType>Debug</BT_BuildType>
        <VerInfo_IncludeVerInfo>true</VerInfo_IncludeVerInfo>
        <VerInfo_Locale>3082</VerInfo_Locale>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base_Android64)'!=''">
        <DCC_UsePackage>rtl;fmx;fmxase;fmxobj;xmlrtl;inet;$(DCC_UsePackage)</DCC_UsePackage>
        <BT_BuildType>Debug</BT_BuildType>
        <Android_MinSdkVersion>23</Android_MinSdkVersion>
        <Android_TargetSdkVersion>34</Android_TargetSdkVersion>
        <VerInfo_IncludeVerInfo>true</VerInfo_IncludeVerInfo>
        <VerInfo_Keys>package=com.factuzam.fotosnube;label=Fotos Nube;versionCode=1;versionName=1.0.0;persistent=False;restoreAnyVersion=False;installLocation=auto;largeHeap=False;theme=TitleBar;hardwareAccelerated=true;apiKey=;buildAPIKey=;minSdkVersion=23;targetSdkVersion=34;debuggable=True</VerInfo_Keys>
        <!-- Permisos Android: el IDE los inyecta en el manifest al compilar.
             Asi llegan por git pull sin tener que marcar los checkboxes en
             Project Options > Uses Permissions. -->
        <Android_Camera>true</Android_Camera>
        <Android_Internet>true</Android_Internet>
        <Android_AccessNetworkState>true</Android_AccessNetworkState>
        <Android_ReadExternalStorage>true</Android_ReadExternalStorage>
        <Android_WriteExternalStorage>true</Android_WriteExternalStorage>
        <Android_ReadMediaImages>true</Android_ReadMediaImages>
        <!-- Iconos de lanzador: el IDE despliega cada PNG a res/drawable-*
             como ic_launcher.png. Asi el manifest encuentra el icono y no
             falla con 'resource drawable/ic_launcher not found'. -->
        <Android_LauncherIcon36>res\ic_launcher_36.png</Android_LauncherIcon36>
        <Android_LauncherIcon48>res\ic_launcher_48.png</Android_LauncherIcon48>
        <Android_LauncherIcon72>res\ic_launcher_72.png</Android_LauncherIcon72>
        <Android_LauncherIcon96>res\ic_launcher_96.png</Android_LauncherIcon96>
        <Android_LauncherIcon144>res\ic_launcher_144.png</Android_LauncherIcon144>
        <Android_LauncherIcon192>res\ic_launcher_192.png</Android_LauncherIcon192>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_1)'!=''">
        <DCC_Define>DEBUG;$(DCC_Define)</DCC_Define>
        <DCC_DebugDCUs>true</DCC_DebugDCUs>
        <DCC_Optimize>false</DCC_Optimize>
        <DCC_GenerateStackFrames>true</DCC_GenerateStackFrames>
        <DCC_DebugInfoInExe>true</DCC_DebugInfoInExe>
        <DCC_RemoteDebug>true</DCC_RemoteDebug>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_2)'!=''">
        <DCC_LocalDebugSymbols>false</DCC_LocalDebugSymbols>
        <DCC_Define>RELEASE;$(DCC_Define)</DCC_Define>
        <DCC_SymbolReferenceInfo>0</DCC_SymbolReferenceInfo>
        <DCC_DebugInformation>0</DCC_DebugInformation>
    </PropertyGroup>
    <ItemGroup>
        <DelphiCompile Include="$(MainSource)">
            <MainSource>MainSource</MainSource>
        </DelphiCompile>
        <DCCReference Include="UPrincipal.pas">
            <Form>frmPrincipal</Form>
            <FormType>fmx</FormType>
        </DCCReference>
        <DCCReference Include="UConfigFotos.pas"/>
        <DCCReference Include="UImagenUtil.pas"/>
        <DCCReference Include="UColaFotosNube.pas"/>
        <BuildConfiguration Include="Base">
            <Key>Base</Key>
        </BuildConfiguration>
        <BuildConfiguration Include="Debug">
            <Key>Cfg_1</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
        <BuildConfiguration Include="Release">
            <Key>Cfg_2</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Delphi.Personality.12</Borland.Personality>
        <Borland.ProjectType>Application</Borland.ProjectType>
        <BorlandProject>
            <Delphi.Personality>
                <Source>
                    <Source Name="MainSource">SubirFotosFmx.dpr</Source>
                </Source>
                <Platforms>
                    <Platform value="Win32">False</Platform>
                    <Platform value="Android64">True</Platform>
                </Platforms>
                <Deployment Version="5">
                    <DeployFile LocalName="res\ic_launcher_36.png" Configuration="Debug" Class="Android_LauncherIcon36">
                        <Platform Name="Android64">
                            <RemoteDir>res\drawable-ldpi</RemoteDir>
                            <RemoteName>ic_launcher.png</RemoteName>
                            <Overwrite>true</Overwrite>
                        </Platform>
                    </DeployFile>
                    <DeployFile LocalName="res\ic_launcher_48.png" Configuration="Debug" Class="Android_LauncherIcon48">
                        <Platform Name="Android64">
                            <RemoteDir>res\drawable-mdpi</RemoteDir>
                            <RemoteName>ic_launcher.png</RemoteName>
                            <Overwrite>true</Overwrite>
                        </Platform>
                    </DeployFile>
                    <DeployFile LocalName="res\ic_launcher_72.png" Configuration="Debug" Class="Android_LauncherIcon72">
                        <Platform Name="Android64">
                            <RemoteDir>res\drawable-hdpi</RemoteDir>
                            <RemoteName>ic_launcher.png</RemoteName>
                            <Overwrite>true</Overwrite>
                        </Platform>
                    </DeployFile>
                    <DeployFile LocalName="res\ic_launcher_96.png" Configuration="Debug" Class="Android_LauncherIcon96">
                        <Platform Name="Android64">
                            <RemoteDir>res\drawable-xhdpi</RemoteDir>
                            <RemoteName>ic_launcher.png</RemoteName>
                            <Overwrite>true</Overwrite>
                        </Platform>
                    </DeployFile>
                    <DeployFile LocalName="res\ic_launcher_144.png" Configuration="Debug" Class="Android_LauncherIcon144">
                        <Platform Name="Android64">
                            <RemoteDir>res\drawable-xxhdpi</RemoteDir>
                            <RemoteName>ic_launcher.png</RemoteName>
                            <Overwrite>true</Overwrite>
                        </Platform>
                    </DeployFile>
                    <DeployFile LocalName="res\ic_launcher_192.png" Configuration="Debug" Class="Android_LauncherIcon192">
                        <Platform Name="Android64">
                            <RemoteDir>res\drawable-xxxhdpi</RemoteDir>
                            <RemoteName>ic_launcher.png</RemoteName>
                            <Overwrite>true</Overwrite>
                        </Platform>
                    </DeployFile>
                    <DeployFile LocalName="res\splash_426.png" Configuration="Debug" Class="Android_SplashImage426">
                        <Platform Name="Android64">
                            <RemoteDir>res\drawable-small</RemoteDir>
                            <RemoteName>splash_image.png</RemoteName>
                            <Overwrite>true</Overwrite>
                        </Platform>
                    </DeployFile>
                    <DeployFile LocalName="res\splash_470.png" Configuration="Debug" Class="Android_SplashImage470">
                        <Platform Name="Android64">
                            <RemoteDir>res\drawable-normal</RemoteDir>
                            <RemoteName>splash_image.png</RemoteName>
                            <Overwrite>true</Overwrite>
                        </Platform>
                    </DeployFile>
                    <DeployFile LocalName="res\splash_640.png" Configuration="Debug" Class="Android_SplashImage640">
                        <Platform Name="Android64">
                            <RemoteDir>res\drawable-large</RemoteDir>
                            <RemoteName>splash_image.png</RemoteName>
                            <Overwrite>true</Overwrite>
                        </Platform>
                    </DeployFile>
                    <DeployFile LocalName="res\splash_960.png" Configuration="Debug" Class="Android_SplashImage960">
                        <Platform Name="Android64">
                            <RemoteDir>res\drawable-xlarge</RemoteDir>
                            <RemoteName>splash_image.png</RemoteName>
                            <Overwrite>true</Overwrite>
                        </Platform>
                    </DeployFile>
                    <DeployFile LocalName="res\splash_470.png" Configuration="Debug" Class="Android_SplashImage470">
                        <Platform Name="Android64">
                            <RemoteDir>res\drawable</RemoteDir>
                            <RemoteName>splash_image.png</RemoteName>
                            <Overwrite>true</Overwrite>
                        </Platform>
                    </DeployFile>
                </Deployment>
            </Delphi.Personality>
        </BorlandProject>
    </ProjectExtensions>
    <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Delphi.Targets')"/>
    <Import Project="$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj" Condition="Exists('$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj')"/>
    <Import Project="$(MSBuildProjectName).deployproj" Condition="Exists('$(MSBuildProjectName).deployproj')"/>
</Project>
