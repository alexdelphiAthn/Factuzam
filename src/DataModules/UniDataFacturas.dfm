  object unqryConsolidacion: TUniQuery
    SQLInsert.Strings = (
      'INSERT INTO fza_facturas_consolidaciones'
      
        '  (ID_CONSOLIDACION, SERIE_FACTURA_CONSOLIDACION, NRO_FACTURA_CO' +
        'NSOLIDACION, REQUEST_ID_CONSOLIDACION, QUEUE_ID_CONSOLIDACION, Q' +
        'UEUE_ID_CANCEL_CONSOLIDACION, ISSUER_IRS_ID_CONSOLIDACION, ISSUE' +
        'D_TIME_CONSOLIDACION, CHAIN_NUMBER_CONSOLIDACION, CHAIN_HASH_CON' +
        'SOLIDACION, VERIFACTU_URL_CONSOLIDACION, QRCODE_BASE64_CONSOLIDA' +
        'CION, QRCODE_PNG_CONSOLIDACION, FECHA_PROCESAMIENTO_CONSOLIDACIO' +
        'N, ESTADO_CONSOLIDACION, RESPUESTA_COMPLETA_CONSOLIDACION, PETIC' +
        'ION_COMPLETA_CONSOLIDACION)'
      'VALUES'
      
        '  (:ID_CONSOLIDACION, :SERIE_FACTURA_CONSOLIDACION, :NRO_FACTURA' +
        '_CONSOLIDACION, :REQUEST_ID_CONSOLIDACION, :QUEUE_ID_CONSOLIDACI' +
        'ON, :QUEUE_ID_CANCEL_CONSOLIDACION, :ISSUER_IRS_ID_CONSOLIDACION' +
        ', :ISSUED_TIME_CONSOLIDACION, :CHAIN_NUMBER_CONSOLIDACION, :CHAI' +
        'N_HASH_CONSOLIDACION, :VERIFACTU_URL_CONSOLIDACION, :QRCODE_BASE' +
        '64_CONSOLIDACION, :QRCODE_PNG_CONSOLIDACION, :FECHA_PROCESAMIENT' +
        'O_CONSOLIDACION, :ESTADO_CONSOLIDACION, :RESPUESTA_COMPLETA_CONS' +
        'OLIDACION, :PETICION_COMPLETA_CONSOLIDACION)')
    SQLDelete.Strings = (
      'DELETE FROM fza_facturas_consolidaciones'
      'WHERE'
      '  ID_CONSOLIDACION = :Old_ID_CONSOLIDACION')
    SQLUpdate.Strings = (
      'UPDATE fza_facturas_consolidaciones'
      'SET'
      
        '  ID_CONSOLIDACION = :ID_CONSOLIDACION, SERIE_FACTURA_CONSOLIDAC' +
        'ION = :SERIE_FACTURA_CONSOLIDACION, NRO_FACTURA_CONSOLIDACION = ' +
        ':NRO_FACTURA_CONSOLIDACION, REQUEST_ID_CONSOLIDACION = :REQUEST_' +
        'ID_CONSOLIDACION, QUEUE_ID_CONSOLIDACION = :QUEUE_ID_CONSOLIDACI' +
        'ON, QUEUE_ID_CANCEL_CONSOLIDACION = :QUEUE_ID_CANCEL_CONSOLIDACI' +
        'ON, ISSUER_IRS_ID_CONSOLIDACION = :ISSUER_IRS_ID_CONSOLIDACION, ' +
        'ISSUED_TIME_CONSOLIDACION = :ISSUED_TIME_CONSOLIDACION, CHAIN_NU' +
        'MBER_CONSOLIDACION = :CHAIN_NUMBER_CONSOLIDACION, CHAIN_HASH_CON' +
        'SOLIDACION = :CHAIN_HASH_CONSOLIDACION, VERIFACTU_URL_CONSOLIDAC' +
        'ION = :VERIFACTU_URL_CONSOLIDACION, QRCODE_BASE64_CONSOLIDACION ' +
        '= :QRCODE_BASE64_CONSOLIDACION, QRCODE_PNG_CONSOLIDACION = :QRCO' +
        'DE_PNG_CONSOLIDACION, FECHA_PROCESAMIENTO_CONSOLIDACION = :FECHA' +
        '_PROCESAMIENTO_CONSOLIDACION, ESTADO_CONSOLIDACION = :ESTADO_CON' +
        'SOLIDACION, RESPUESTA_COMPLETA_CONSOLIDACION = :RESPUESTA_COMPLE' +
        'TA_CONSOLIDACION, PETICION_COMPLETA_CONSOLIDACION = :PETICION_CO' +
        'MPLETA_CONSOLIDACION'
      'WHERE'
      '  ID_CONSOLIDACION = :Old_ID_CONSOLIDACION')
    SQLLock.Strings = (
      
        'SELECT ID_CONSOLIDACION, SERIE_FACTURA_CONSOLIDACION, NRO_FACTUR' +
        'A_CONSOLIDACION, REQUEST_ID_CONSOLIDACION, QUEUE_ID_CONSOLIDACIO' +
        'N, QUEUE_ID_CANCEL_CONSOLIDACION, ISSUER_IRS_ID_CONSOLIDACION, I' +
        'SSUED_TIME_CONSOLIDACION, CHAIN_NUMBER_CONSOLIDACION, CHAIN_HASH' +
        '_CONSOLIDACION, VERIFACTU_URL_CONSOLIDACION, QRCODE_BASE64_CONSO' +
        'LIDACION, QRCODE_PNG_CONSOLIDACION, FECHA_PROCESAMIENTO_CONSOLID' +
        'ACION, ESTADO_CONSOLIDACION, RESPUESTA_COMPLETA_CONSOLIDACION, P' +
        'ETICION_COMPLETA_CONSOLIDACION FROM fza_facturas_consolidaciones'
      'WHERE'
      '  ID_CONSOLIDACION = :Old_ID_CONSOLIDACION'
      'FOR UPDATE')
    SQLRefresh.Strings = (
      
        'SELECT ID_CONSOLIDACION, SERIE_FACTURA_CONSOLIDACION, NRO_FACTUR' +
        'A_CONSOLIDACION, REQUEST_ID_CONSOLIDACION, QUEUE_ID_CONSOLIDACIO' +
        'N, QUEUE_ID_CANCEL_CONSOLIDACION, ISSUER_IRS_ID_CONSOLIDACION, I' +
        'SSUED_TIME_CONSOLIDACION, CHAIN_NUMBER_CONSOLIDACION, CHAIN_HASH' +
        '_CONSOLIDACION, VERIFACTU_URL_CONSOLIDACION, QRCODE_BASE64_CONSO' +
        'LIDACION, QRCODE_PNG_CONSOLIDACION, FECHA_PROCESAMIENTO_CONSOLID' +
        'ACION, ESTADO_CONSOLIDACION, RESPUESTA_COMPLETA_CONSOLIDACION, P' +
        'ETICION_COMPLETA_CONSOLIDACION FROM fza_facturas_consolidaciones'
      'WHERE'
      '  ID_CONSOLIDACION = :ID_CONSOLIDACION')
    SQLRecCount.Strings = (
      'SELECT COUNT(*) FROM fza_facturas_consolidaciones')
    Connection = dmConn.conUni
    SQL.Strings = (
      'SELECT * FROM fza_facturas_consolidaciones'
      'WHERE NRO_FACTURA_CONSOLIDACION = :NRO_FACTURA'
      'AND SERIE_FACTURA_CONSOLIDACION = :SERIE_FACTURA'
      'ORDER BY ID_CONSOLIDACION DESC')
    MasterSource = frmMtoFacturas.dsTablaG
    MasterFields = 'SERIE_FACTURA;NRO_FACTURA'
    DetailFields = 'ID_CONSOLIDACION;NRO_FACTURA_CONSOLIDACION'
