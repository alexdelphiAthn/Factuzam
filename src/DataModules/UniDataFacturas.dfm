  object unqryFormaPago: TUniQuery
    SQLInsert.Strings = (
      'INSERT INTO fza_formapago'
      
        '  (CODIGO_FORMAPAGO, ACTIVO_FORMAPAGO, ORDEN_FORMAPAGO, DESCRIPC' +
        'ION_FORMAPAGO, N_PLAZOS_FORMAPAGO, N_DIAS_ENTRE_PLAZOS_FORMAPAGO' +
        ', PORCEN_ANTICIPO_FORMAPAGO, ESDEFAULT_FORMAPAGO, INSTANTEMODIF,' +
        ' INSTANTEALTA, USUARIOALTA, USUARIOMODIF)'
      'VALUES'
      
        '  (:CODIGO_FORMAPAGO, :ACTIVO_FORMAPAGO, :ORDEN_FORMAPAGO, :DESC' +
        'RIPCION_FORMAPAGO, :N_PLAZOS_FORMAPAGO, :N_DIAS_ENTRE_PLAZOS_FOR' +
        'MAPAGO, :PORCEN_ANTICIPO_FORMAPAGO, :ESDEFAULT_FORMAPAGO, :INSTA' +
        'NTEMODIF, :INSTANTEALTA, :USUARIOALTA, :USUARIOMODIF)')
    SQLDelete.Strings = (
      'DELETE FROM fza_formapago'
      'WHERE'
      '  CODIGO_FORMAPAGO = :Old_CODIGO_FORMAPAGO')
    SQLUpdate.Strings = (
      'UPDATE fza_formapago'
      'SET'
      
        '  CODIGO_FORMAPAGO = :CODIGO_FORMAPAGO, ACTIVO_FORMAPAGO = :ACTI' +
        'VO_FORMAPAGO, ORDEN_FORMAPAGO = :ORDEN_FORMAPAGO, DESCRIPCION_FO' +
        'RMAPAGO = :DESCRIPCION_FORMAPAGO, N_PLAZOS_FORMAPAGO = :N_PLAZOS' +
        '_FORMAPAGO, N_DIAS_ENTRE_PLAZOS_FORMAPAGO = :N_DIAS_ENTRE_PLAZOS' +
        '_FORMAPAGO, PORCEN_ANTICIPO_FORMAPAGO = :PORCEN_ANTICIPO_FORMAPA' +
        'GO, ESDEFAULT_FORMAPAGO = :ESDEFAULT_FORMAPAGO, INSTANTEMODIF = ' +
        ':INSTANTEMODIF, INSTANTEALTA = :INSTANTEALTA, USUARIOALTA = :USU' +
        'ARIOALTA, USUARIOMODIF = :USUARIOMODIF'
      'WHERE'
      '  CODIGO_FORMAPAGO = :Old_CODIGO_FORMAPAGO')
    SQLLock.Strings = (
      'SELECT * FROM fza_formapago'
      'WHERE'
      '  CODIGO_FORMAPAGO = :Old_CODIGO_FORMAPAGO'
      'FOR UPDATE')
    SQLRefresh.Strings = (
      
        'SELECT CODIGO_FORMAPAGO, ACTIVO_FORMAPAGO, ORDEN_FORMAPAGO, DESC' +
        'RIPCION_FORMAPAGO, N_PLAZOS_FORMAPAGO, N_DIAS_ENTRE_PLAZOS_FORMA' +
        'PAGO, PORCEN_ANTICIPO_FORMAPAGO, ESDEFAULT_FORMAPAGO, INSTANTEMO' +
        'DIF, INSTANTEALTA, USUARIOALTA, USUARIOMODIF FROM fza_formapago'
      'WHERE'
      '  CODIGO_FORMAPAGO = :CODIGO_FORMAPAGO')
    SQLRecCount.Strings = (
      'SELECT COUNT(*) FROM fza_formapago')
    Connection = dmConn.conUni
    SQL.Strings = (
      'select * from vi_formapago'
      '')
    ReadOnly = True
    Left = 464
    Top = 176
  end
