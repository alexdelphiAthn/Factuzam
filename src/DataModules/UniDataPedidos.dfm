  object unqryPedidosLineas: TUniQuery
    SQLInsert.Strings = (
      'INSERT INTO fza_pedidos_lineas'
      
        '  (NUMERO_PED_PEDLIN, SERIE_PED_PEDLIN, LINEA_PEDLIN, IDLINEAPS_' +
        'PEDLIN, IDPRODPS_PEDLIN, CODIGOPRODPS_PEDLIN, IDATRIBPRODPS_PEDL' +
