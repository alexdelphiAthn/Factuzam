        'CRIPCION_ARTICULO_PEDLIN, CODIGO_TAR_PEDLIN, CANTIDAD_PEDLIN, CA' +
        'NTIDAD_ENTREGADA_PEDLIN, CANTIDAD_PENDIENTE_PEDLIN, ESENTREGADA_' +
        'PEDLIN, CODIGO_ALMACEN_PEDLIN, PRECIO_VENTA_SIVA_ARTICULO_PEDLIN' +
        ', PORCENTAJE_IVA_PEDLIN, PRECIO_V' +
        'ENTA_CIVA_ARTICULO_PEDLIN, TOTAL_PEDLIN, INSTANTE_MODIF, INSTANT' +
        'E_ALTA, USUARIO_ALTA, USUARIO_MODIF FROM fza_pedidos_lineas'
      'WHERE'
      
        '  NUMERO_PED_PEDLIN = :NUMERO_PED_PEDLIN AND SERIE_PED_PEDLIN = ' +
        ':SERIE_PED_PEDLIN AND LINEA_PEDLIN = :LINEA_PEDLIN')
    SQLRecCount.Strings = (
      'SELECT COUNT(*) FROM fza_pedidos_lineas')
    Connection = dmConn.conUni
    SQL.Strings = (
      'SELECT * FROM vi_pedidos_lineas')
    MasterFields = 'NUMERO_PED;SERIE_PED'
    DetailFields = 'NUMERO_PED_PEDLIN;SERIE_PED_PEDLIN'
