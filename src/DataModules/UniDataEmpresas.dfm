        'RES_FAC, TOTAL_BASEI_IVAS_FAC, PORCENTAJE_IVAE_FAC, TOTAL_IVAE_F' +
        'AC, PORCENTAJE_REE_FAC, TOTAL_REE_FAC, TOTAL_BASEI_IVAE_FAC, TOT' +
        'AL_BASES_FAC, TOTAL_IMPUESTOS_FAC, FORMA_PAGO_FAC, PORCENTAJE_RE' +
        'TENCION_FAC, TOTAL_RETENCION_FAC, TOTAL_LIQUIDO_FAC, NUMERO_FAC_' +
