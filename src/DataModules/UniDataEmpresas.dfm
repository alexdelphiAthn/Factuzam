        'ALTA, USUARIO_ALTA, USUARIO_MODIF FROM fza_empresas_series'
      'WHERE'
      '  CODIGO_SERIE_EMPSER = :Old_CODIGO_SERIE_EMPSER'
      'FOR UPDATE')
