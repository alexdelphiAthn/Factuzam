        'FECHA_HASTA_EMPSER, INSTANTE_MODIF = :INSTANTE_MODIF, INSTANTE_A' +
        'LTA = :INSTANTE_ALTA, USUARIO_ALTA = :USUARIO_ALTA, USUARIO_MODI' +
        'F = :USUARIO_MODIF'
      'WHERE'
      '  CODIGO_SERIE_EMPSER = :Old_CODIGO_SERIE_EMPSER')
    SQLLock.Strings = (
      
        'SELECT CODIGO_SERIE_EMPSER, CODIGO_EMP_EMPSER, CODIGO_ALM_EMPSER' +
        ', CODIGO_CAJA_EMPSER, EMPSER, TIPO_DOC_EMPSER, SUBTIPO_EMPSER, F' +
