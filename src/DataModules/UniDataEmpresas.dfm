  object unqrySeries: TUniQuery
    SQLInsert.Strings = (
      'INSERT INTO fza_empresas_series'
      
        '  (CODIGO_SERIE_EMPSER, CODIGO_EMP_EMPSER, CODIGO_ALM_EMPSER, CO' +
        'DIGO_CAJA_EMPSER, EMPSER, TIPO_DOC_EMPSER, SUBTIPO_EMPSER, FECHA' +
        '_DESDE_EMPSER, FECHA_HASTA_EMPSER, INSTANTE_MODIF, INSTANTE_ALTA' +
        ', USUARIO_ALTA, USUARIO_MODIF)'
      'VALUES'
      
        '  (:CODIGO_SERIE_EMPSER, :CODIGO_EMP_EMPSER, :CODIGO_ALM_EMPSER,' +
        ' :CODIGO_CAJA_EMPSER, :EMPSER, :TIPO_DOC_EMPSER, :SUBTIPO_EMPSER' +
        ', :FECHA_DESDE_EMPSER, :FECHA_HASTA_EMPSER, :INSTANTE_MODIF, :IN' +
        'STANTE_ALTA, :USUARIO_ALTA, :USUARIO_MODIF)')
    SQLDelete.Strings = (
      'DELETE FROM fza_empresas_series'
      'WHERE'
      '  CODIGO_SERIE_EMPSER = :Old_CODIGO_SERIE_EMPSER')
    SQLUpdate.Strings = (
      'UPDATE fza_empresas_series'
      'SET'
      
        '  CODIGO_SERIE_EMPSER = :CODIGO_SERIE_EMPSER, CODIGO_EMP_EMPSER ' +
        '= :CODIGO_EMP_EMPSER, CODIGO_ALM_EMPSER = :CODIGO_ALM_EMPSER, CO' +
        'DIGO_CAJA_EMPSER = :CODIGO_CAJA_EMPSER, EMPSER = :EMPSER, TIPO_D' +
        'OC_EMPSER = :TIPO_DOC_EMPSER, SUBTIPO_EMPSER = :SUBTIPO_EMPSER, ' +
