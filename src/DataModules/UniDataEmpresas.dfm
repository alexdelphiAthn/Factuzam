        'VA_FAC = :PALABRA_REPORTS_ZONA_IVA_FAC, ESVENTA_ACTIVO_FIJO_FAC ' +
        '= :ESVENTA_ACTIVO_FIJO_FAC, PORCENTAJE_IVAN_FAC = :PORCENTAJE_IV' +
