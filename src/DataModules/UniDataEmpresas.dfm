        ' DESCRIPCION_ARTICULO_FACLIN, CODIGO_TAR_FACLIN, CANTIDAD_FACLIN' +
        ', PRECIO_SALIDA_FACLIN, PORCENTAJE_DTO_FACLIN, PRECIO_DTO_FACLIN' +
