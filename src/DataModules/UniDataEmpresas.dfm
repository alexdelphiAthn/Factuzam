        'REPORTS_ZONA_IVA_FAC, :ESVENTA_ACTIVO_FIJO_FAC, :PORCENTAJE_IVAN' +
        '_FAC, :TOTAL_IVAN_FAC, :PORCENTAJE_REN_FAC, :TOTAL_REN_FAC, :TOT' +
        'AL_BASEI_IVAN_FAC, :PORCENTAJE_IVAR_FAC, :TOTAL_IVAR_FAC, :PORCE' +
