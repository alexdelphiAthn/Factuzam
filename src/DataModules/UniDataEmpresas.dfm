        'N = :Old_SERIE_FAC_FACLIN AND LINEA_FACLIN = :Old_LINEA_FACLIN')
    SQLUpdate.Strings = (
      'UPDATE fza_facturas_lineas'
      'SET'
      
        '  NUMERO_FAC_FACLIN = :NUMERO_FAC_FACLIN, SERIE_FAC_FACLIN = :SE' +
