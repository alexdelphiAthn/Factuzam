  object unqryRetenciones: TUniQuery
    SQLInsert.Strings = (
      'INSERT INTO fza_empresas_retenciones'
      
        '  (CODIGO_RETENCION_EMPRET, CODIGO_EMP_EMPRET, PORCENTAJE_EMPRET' +
        ', FECHA_DESDE_EMPRET, FECHA_HASTA_EMPRET, INSTANTE_MODIF, INSTAN' +
        'TE_ALTA, USUARIO_ALTA, USUARIO_MODIF)'
      'VALUES'
      
        '  (:CODIGO_RETENCION_EMPRET, :CODIGO_EMP_EMPRET, :PORCENTAJE_EMP' +
        'RET, :FECHA_DESDE_EMPRET, :FECHA_HASTA_EMPRET, :INSTANTE_MODIF, ' +
        ':INSTANTE_ALTA, :USUARIO_ALTA, :USUARIO_MODIF)')
    SQLDelete.Strings = (
      'DELETE FROM fza_empresas_retenciones'
      'WHERE'
      '  CODIGO_RETENCION_EMPRET = :Old_CODIGO_RETENCION_EMPRET')
    SQLUpdate.Strings = (
      'UPDATE fza_empresas_retenciones'
      'SET'
      
        '  CODIGO_RETENCION_EMPRET = :CODIGO_RETENCION_EMPRET, CODIGO_EMP' +
        '_EMPRET = :CODIGO_EMP_EMPRET, PORCENTAJE_EMPRET = :PORCENTAJE_EM' +
        'PRET, FECHA_DESDE_EMPRET = :FECHA_DESDE_EMPRET, FECHA_HASTA_EMPR' +
        'ET = :FECHA_HASTA_EMPRET, INSTANTE_MODIF = :INSTANTE_MODIF, INST' +
        'ANTE_ALTA = :INSTANTE_ALTA, USUARIO_ALTA = :USUARIO_ALTA, USUARI' +
        'O_MODIF = :USUARIO_MODIF'
      'WHERE'
      '  CODIGO_RETENCION_EMPRET = :Old_CODIGO_RETENCION_EMPRET')
    SQLLock.Strings = (
      'SELECT * FROM fza_empresas_retenciones'
      'WHERE'
      '  CODIGO_RETENCION_EMPRET = :Old_CODIGO_RETENCION_EMPRET'
      'FOR UPDATE')
    SQLRefresh.Strings = (
      
        'SELECT CODIGO_RETENCION_EMPRET, CODIGO_EMP_EMPRET, PORCENTAJE_EM' +
        'PRET, FECHA_DESDE_EMPRET, FECHA_HASTA_EMPRET, INSTANTE_MODIF, IN' +
        'STANTE_ALTA, USUARIO_ALTA, USUARIO_MODIF FROM fza_empresas_reten' +
        'ciones'
      'WHERE'
