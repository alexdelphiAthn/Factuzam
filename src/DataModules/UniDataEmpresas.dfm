        'OLA_EMPRESA_FAC = :ESREGIMENESPECIALAGRICOLA_EMPRESA_FAC, CODIGO' +
        '_CLI_FAC = :CODIGO_CLI_FAC, RAZON_SOCIAL_CLIENTE_FAC = :RAZON_SO' +
        'CIAL_CLIENTE_FAC, NIF_CLIENTE_FAC = :NIF_CLIENTE_FAC, MOVIL_CLIE' +
