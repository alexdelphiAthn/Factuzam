    Connection = dmConn.conUni
    SQL.Strings = (
      'SELECT * '
      'FROM vi_empresas_retenciones'
      'WHERE CODIGO_EMP_EMPRET = :CODIGO_EMP_EMP')
    MasterFields = 'CODIGO_EMP_EMP'
    DetailFields = 'CODIGO_EMP_EMPRET'
    RefreshOptions = [roAfterUpdate]
