  inherited unqryTablaG: TUniQuery
    SQLInsert.Strings = (
      'INSERT INTO fza_empresas'
      
        '  (CODIGO_EMP_EMP, ORDEN_EMP, ESACTIVO_EMP, RAZON_SOCIAL_EMP, NI' +
        'F_EMP, MOVIL_EMP, EMAIL_EMP, DIRECCION1_EMP, DIRECCION2_EMP, COD' +
        'IGO_POSTAL_EMP, POBLACION_EMP, PROVINCIA_EMP, CODIGO_PAI_EMP, NO' +
        'MBRE_PAI_EMP, IBAN_EMP, GRUPO_ZONA_IVA_EMP, ESRETENCIONES_EMP, E' +
        'SIVA_RECARGO_COMPRAS_EMP, ESREGIMENESPECIALAGRICOLA_EMP, CODIGO_' +
        'CERTIFICADO_EMP, TITULAR_CE' +
        'RTIFICADO_EMP, TIPO_CERTIFICADO_EMP, FECHA_DESDE_CERTIFICADO_EMP' +
        ', FECHA_HASTA_CERTIFICADO_EMP, TEXTO_LEGAL_FACTURA_EMP, INSTANTE' +
        '_MODIF, INSTANTE_ALTA, USUARIO_ALTA, USUARIO_MODIF)'
      'VALUES'
      
        '  (:CODIGO_EMP_EMP, :ORDEN_EMP, :ESACTIVO_EMP, :RAZON_SOCIAL_EMP' +
        ', :NIF_EMP, :MOVIL_EMP, :EMAIL_EMP, :DIRECCION1_EMP, :DIRECCION2' +
        '_EMP, :CODIGO_POSTAL_EMP, :POBLACION_EMP, :PROVINCIA_EMP, :CODIG' +
        'O_PAI_EMP, :NOMBRE_PAI_EMP, :IBAN_EMP, :GRUPO_ZONA_IVA_EMP, :ESR' +
        'ETENCIONES_EMP, :ESIVA_RECARGO_COMPRAS_EMP, :ESREGIMENESPECIALAG' +
        'RICOLA_EMP, :CODIGO_CERTIFIC' +
        'ADO_EMP, :TITULAR_CERTIFICADO_EMP, :TIPO_CERTIFICADO_EMP, :FECHA' +
        '_DESDE_CERTIFICADO_EMP, :FECHA_HASTA_CERTIFICADO_EMP, :TEXTO_LEG' +
        'AL_FACTURA_EMP, :INSTANTE_MODIF, :INSTANTE_ALTA, :USUARIO_ALTA, ' +
        ':USUARIO_MODIF)')
    SQLDelete.Strings = (
      'DELETE FROM fza_empresas'
      'WHERE'
      '  CODIGO_EMP_EMP = :Old_CODIGO_EMP_EMP')
    SQLUpdate.Strings = (
      'UPDATE fza_empresas'
      'SET'
      
        '  CODIGO_EMP_EMP = :CODIGO_EMP_EMP, ORDEN_EMP = :ORDEN_EMP, ESAC' +
        'TIVO_EMP = :ESACTIVO_EMP, RAZON_SOCIAL_EMP = :RAZON_SOCIAL_EMP, ' +
        'NIF_EMP = :NIF_EMP, MOVIL_EMP = :MOVIL_EMP, EMAIL_EMP = :EMAIL_E' +
        'MP, DIRECCION1_EMP = :DIRECCION1_EMP, DIRECCION2_EMP = :DIRECCIO' +
        'N2_EMP, CODIGO_POSTAL_EMP = :CODIGO_POSTAL_EMP, POBLACION_EMP = ' +
        ':POBLACION_EMP, PROVINCIA_EMP = :PROVINCIA_EMP, CODIGO_PAI_EMP =' +
        ' :CODIGO_PAI_EMP, NOMBRE_PAI_EMP = :NOMBRE_PAI_EMP, IBAN_EMP = :' +
        'IBAN_EMP, GRUPO_ZONA_IVA_EMP = :GRUPO_ZONA_IVA_EMP, ESRETENCIONE' +
        'S_EMP = :ESRETENCIONES_EMP, ESIVA_RECARGO_COMPRAS_EMP = :ESIVA_R' +
        'ECARGO_COMPRAS_EMP, ESREGIMENESPECIALAGRICOLA_EMP = :ESREGIMENE' +
        'SPECIALAGRICOLA_EMP, CODIGO_CERTIFICADO_EMP = :CODIGO_CER' +
        'TIFICADO_EMP, TITULAR_CERTIFICADO_EMP = :TITULAR_CERTIFICADO_EMP' +
        ', TIPO_CERTIFICADO_EMP = :TIPO_CERTIFICADO_EMP, FECHA_DESDE_CERT' +
        'IFICADO_EMP = :FECHA_DESDE_CERTIFICADO_EMP, FECHA_HASTA_CERTIFIC' +
        'ADO_EMP = :FECHA_HASTA_CERTIFICADO_EMP, TEXTO_LEGAL_FACTURA_EMP ' +
        '= :TEXTO_LEGAL_FACTURA_EMP, INSTANTE_MODIF = :INSTANTE_MODIF, IN' +
        'STANTE_ALTA = :INSTANTE_ALTA, USUARIO_ALTA = :USUARIO_ALTA, USUA' +
        'RIO_MODIF = :USUARIO_MODIF'
      'WHERE'
      '  CODIGO_EMP_EMP = :Old_CODIGO_EMP_EMP')
    SQLLock.Strings = (
      
        'SELECT CODIGO_EMP_EMP, ORDEN_EMP, ESACTIVO_EMP, RAZON_SOCIAL_EMP' +
        ', NIF_EMP, MOVIL_EMP, EMAIL_EMP, DIRECCION1_EMP, DIRECCION2_EMP,' +
        ' CODIGO_POSTAL_EMP, POBLACION_EMP, PROVINCIA_EMP, CODIGO_PAI_EMP' +
        ', NOMBRE_PAI_EMP, IBAN_EMP, GRUPO_ZONA_IVA_EMP, ESRETENCIONES_EM' +
        'P, ESIVA_RECARGO_COMPRAS_EMP, ESREGIMENESPECIALAGRICOLA_EMP, COD' +
        'IGO_CERTIFICADO_EMP, TITULA' +
        'R_CERTIFICADO_EMP, TIPO_CERTIFICADO_EMP, FECHA_DESDE_CERTIFICADO' +
        '_EMP, FECHA_HASTA_CERTIFICADO_EMP, TEXTO_LEGAL_FACTURA_EMP, INST' +
        'ANTE_MODIF, INSTANTE_ALTA, USUARIO_ALTA, USUARIO_MODIF FROM fza_' +
        'empresas'
      'WHERE'
      '  CODIGO_EMP_EMP = :Old_CODIGO_EMP_EMP'
      'FOR UPDATE')
    SQLRefresh.Strings = (
      
        'SELECT CODIGO_EMP_EMP, ORDEN_EMP, ESACTIVO_EMP, RAZON_SOCIAL_EMP' +
        ', NIF_EMP, MOVIL_EMP, EMAIL_EMP, DIRECCION1_EMP, DIRECCION2_EMP,' +
        ' CODIGO_POSTAL_EMP, POBLACION_EMP, PROVINCIA_EMP, CODIGO_PAI_EMP' +
        ', NOMBRE_PAI_EMP, IBAN_EMP, GRUPO_ZONA_IVA_EMP, ESRETENCIONES_EM' +
        'P, ESIVA_RECARGO_COMPRAS_EMP, ESREGIMENESPECIALAGRICOLA_EMP, COD' +
        'IGO_CERTIFICADO_EMP, TITULA' +
        'R_CERTIFICADO_EMP, TIPO_CERTIFICADO_EMP, FECHA_DESDE_CERTIFICADO' +
        '_EMP, FECHA_HASTA_CERTIFICADO_EMP, TEXTO_LEGAL_FACTURA_EMP, INST' +
        'ANTE_MODIF, INSTANTE_ALTA, USUARIO_ALTA, USUARIO_MODIF FROM fza_' +
        'empresas'
      'WHERE'
      '  CODIGO_EMP_EMP = :CODIGO_EMP_EMP')
    SQLRecCount.Strings = (
      'SELECT COUNT(*) FROM fza_empresas')
    Connection = dmConn.conUni
    SQL.Strings = (
      'SELECT *  '
      '  FROM vi_empresas '
      ' ORDER BY orden_emp')
    AfterInsert = unqryTablaGAfterInsert
    BeforeDelete = unqryTablaGBeforeDelete
    AfterDelete = unqryTablaGAfterDelete
  end
  inherited unqryPerfiles: TUniQuery
    SQL.Strings = (
      'select *'
      'from fza_usuarios_perfiles'
      'where (KEY_USUPER = '#39'dmEmpresas'#39' '
      'OR KEY_USUPER='#39'frmMtoEmpresas'#39')')
