        '_FAC, DIRECCION2_CLIENTE_FAC, POBLACION_CLIENTE_FAC, PROVINCIA_C' +
        'LIENTE_FAC, CODIGO_POSTAL_CLIENTE_FAC, CODIGO_PAI_CLIENTE_FAC, N' +
        'OMBRE_PAI_CLIENTE_FAC, CODIGO_IVA_FAC, ESIVA_RECARGO_CLIENTE_FAC' +
        ', ESIVA_EXENTO_CLIENTE_FAC, ESREGIMENESPECIALAGRICOLA_CLIENTE_FA' +
        'C, ESRETENCIONES_CLIENTE_FAC, TARIFA_ARTICULO_CLIENTE_FAC, ESIMP' +
        '_INCL_TARIFA_CLIENTE_FAC, ESINTRACOMUNITARIO_CLIENTE_FAC, ESIRPF' +
