  inherited unqryTablaG: TUniQuery
    SQLInsert.Strings = (
      'INSERT INTO fza_clientes'
      
        '  (CODIGO_CLI_CLI, ESACTIVO_CLI, ORDEN_CLI, RAZON_SOCIAL_CLI, NI' +
        'F_CLI, MOVIL_CLI, EMAIL_CLI, DIRECCION1_CLI, DIRECCION2_CLI, POB' +
        'LACION_CLI, PROVINCIA_CLI, CODIGO_POSTAL_CLI, CODIGO_PAI_CLI, NO' +
        'MBRE_PAI_CLI, OBSERVACIONES_CLI, REFERENCIA_CLI, CONTACTO_CLI, T' +
        'ELEFONO_CONTACTO_CLI, TELEFONO_CLI, IBAN_CLI, ESIVA_RECARGO_CLI,' +
        ' ESRETENCIONES_CLI, TOTAL_LIMITE_CREDITO_CLI, ESPERMITE_DEUDA_CL' +
        'I, TOTAL_DEUDA_CLI, ESIVA_EXENTO_CLI, ESINTRACOMUNITARIO_CLI, ES' +
        'REGIMENESPECIALAGRICOLA_CLI, CODIGO_FP_CLI, TARIFA_ARTICULO_CLI,' +
        ' SERIE_CON_CLI, TEXTO_LEGAL_FACTURA_CLI, INSTANTE_MODIF, INSTANT' +
        'E_ALTA, USUARIO_ALTA, USUARIO_MODIF)'
      'VALUES'
      
        '  (:CODIGO_CLI_CLI, :ESACTIVO_CLI, :ORDEN_CLI, :RAZON_SOCIAL_CLI' +
        ', :NIF_CLI, :MOVIL_CLI, :EMAIL_CLI, :DIRECCION1_CLI, :DIRECCION2' +
        '_CLI, :POBLACION_CLI, :PROVINCIA_CLI, :CODIGO_POSTAL_CLI, :CODIG' +
        'O_PAI_CLI, :NOMBRE_PAI_CLI, :OBSERVACIONES_CLI, :REFERENCIA_CLI,' +
        ' :CONTACTO_CLI, :TELEFONO_CONTACTO_CLI, :TELEFONO_CLI, :IBAN_CLI' +
        ', :ESIVA_RECARGO_CLI, :ESRETENCIONES_CLI, :TOTAL_LIMITE_CREDITO_' +
        'CLI, :ESPERMITE_DEUDA_CLI, :TOTAL_DEUDA_CLI, :ESIVA_EXENTO_CLI, ' +
        ':ESINTRACOMUNITARIO_CLI, :ESREGIMENESPECIALAGRICOLA_CLI, :CODIGO' +
        '_FP_CLI, :TARIFA_ARTICULO_CLI, :SERIE_CON_CLI, :TEXTO_LEGAL_FACT' +
        'URA_CLI, :INSTANTE_MODIF, :INSTANTE_ALTA, :USUARIO_ALTA, :USUARI' +
        'O_MODIF)')
    SQLDelete.Strings = (
      'DELETE FROM fza_clientes'
      'WHERE'
      '  CODIGO_CLI_CLI = :Old_CODIGO_CLI_CLI')
    SQLUpdate.Strings = (
      'UPDATE fza_clientes'
      'SET'
      
        '  CODIGO_CLI_CLI = :CODIGO_CLI_CLI, ESACTIVO_CLI = :ESACTIVO_CLI' +
        ', ORDEN_CLI = :ORDEN_CLI, RAZON_SOCIAL_CLI = :RAZON_SOCIAL_CLI, ' +
        'NIF_CLI = :NIF_CLI, MOVIL_CLI = :MOVIL_CLI, EMAIL_CLI = :EMAIL_C' +
        'LI, DIRECCION1_CLI = :DIRECCION1_CLI, DIRECCION2_CLI = :DIRECCIO' +
        'N2_CLI, POBLACION_CLI = :POBLACION_CLI, PROVINCIA_CLI = :PROVINC' +
        'IA_CLI, CODIGO_POSTAL_CLI = :CODIGO_POSTAL_CLI, CODIGO_PAI_CLI =' +
        ' :CODIGO_PAI_CLI, NOMBRE_PAI_CLI = :NOMBRE_PAI_CLI, OBSERVACIONE' +
        'S_CLI = :OBSERVACIONES_CLI, REFERENCIA_CLI = :REFERENCIA_CLI, CO' +
        'NTACTO_CLI = :CONTACTO_CLI, TELEFONO_CONTACTO_CLI = :TELEFONO_CO' +
        'NTACTO_CLI, TELEFONO_CLI = :TELEFONO_CLI, IBAN_CLI = :IBAN_CLI, ' +
        'ESIVA_RECARGO_CLI = :ESIVA_RECARGO_CLI, ESRETENCIONES_CLI = :ESR' +
        'ETENCIONES_CLI, TOTAL_LIMITE_CREDITO_CLI = :TOTAL_LIMITE_CREDITO' +
        '_CLI, ESPERMITE_DEUDA_CLI = :ESPERMITE_DEUDA_CLI, TOTAL_DEUDA_CL' +
        'I = :TOTAL_DEUDA_CLI, ESIVA_EXENTO_CLI = :ESIVA_EXENTO_CLI, ESIN' +
        'TRACOMUNITARIO_CLI = :ESINTRACOMUNITARIO_CLI, ESREGIMENESPECIALA' +
        'GRICOLA_CLI = :ESREGIMENESPECIALAGRICOLA_CLI, CODIGO_FP_CLI = :C' +
        'ODIGO_FP_CLI, TARIFA_ARTICULO_CLI = :TARIFA_ARTICULO_CLI, SERIE_' +
        'CON_CLI = :SERIE_CON_CLI, TEXTO_LEGAL_FACTURA_CLI = :TEXTO_LEGAL' +
        '_FACTURA_CLI, INSTANTE_MODIF = :INSTANTE_MODIF, INSTANTE_ALTA = ' +
        ':INSTANTE_ALTA, USUARIO_ALTA = :USUARIO_ALTA, USUARIO_MODIF = :U' +
        'SUARIO_MODIF'
      'WHERE'
      '  CODIGO_CLI_CLI = :Old_CODIGO_CLI_CLI')
    SQLLock.Strings = (
      
        'SELECT CODIGO_CLI_CLI, ESACTIVO_CLI, ORDEN_CLI, RAZON_SOCIAL_CLI' +
        ', NIF_CLI, MOVIL_CLI, EMAIL_CLI, DIRECCION1_CLI, DIRECCION2_CLI,' +
        ' POBLACION_CLI, PROVINCIA_CLI, CODIGO_POSTAL_CLI, CODIGO_PAI_CLI' +
        ', NOMBRE_PAI_CLI, OBSERVACIONES_CLI, REFERENCIA_CLI, CONTACTO_CL' +
        'I, TELEFONO_CONTACTO_CLI, TELEFONO_CLI, IBAN_CLI, ESIVA_RECARGO_' +
        'CLI, ESRETENCIONES_CLI, TOTAL_LIMITE_CREDITO_CLI, ESPERMITE_DEUD' +
        'A_CLI, TOTAL_DEUDA_CLI, ESIVA_EXENTO_CLI, ESINTRACOMUNITARIO_CLI' +
        ', ESREGIMENESPECIALAGRICOLA_CLI, CODIGO_FP_CLI, TARIFA_ARTICULO_' +
        'CLI, SERIE_CON_CLI, TEXTO_LEGAL_FACTURA_CLI, INSTANTE_MODIF, INS' +
        'TANTE_ALTA, USUARIO_ALTA, USUARIO_MODIF FROM fza_clientes'
      'WHERE'
      '  CODIGO_CLI_CLI = :Old_CODIGO_CLI_CLI'
      'FOR UPDATE')
    SQLRefresh.Strings = (
      
        'SELECT CODIGO_CLI_CLI, ESACTIVO_CLI, ORDEN_CLI, RAZON_SOCIAL_CLI' +
        ', NIF_CLI, MOVIL_CLI, EMAIL_CLI, DIRECCION1_CLI, DIRECCION2_CLI,' +
