        'N = :Old_SERIE_FAC_FACLIN AND LINEA_FACLIN = :Old_LINEA_FACLIN'
      'FOR UPDATE')
    SQLRefresh.Strings = (
      
        'SELECT NUMERO_FAC_FACLIN, SERIE_FAC_FACLIN, LINEA_FACLIN, CODIGO' +
        '_ART_FACLIN, CODIGO_FAM_FACLIN, NOMBRE_FAM_FACLIN, PRECIO_ULT_CO' +
