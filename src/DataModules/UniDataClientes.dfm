        '_FACTURA_LINEA, ESPROVEEDORPRINCIPAL_FACTURA_LINEA = :ESPROVEEDO' +
        'RPRINCIPAL_FACTURA_LINEA, FECHA_ENTREGA_FACTURA_LINEA = :FECHA_E' +
