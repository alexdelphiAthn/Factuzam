        'ION_HISTORIA = :DESCRIPCION_HISTORIA, NUMERO_FAC = :NUMERO_FAC, LINEA_LINEA = :LINEA_LINEA, ODONTOLOGO = :ODONTOLOGO, SERIE_FAC = :SERIE_FAC'
