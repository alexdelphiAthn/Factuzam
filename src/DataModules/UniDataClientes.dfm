        'CCION1_CLI = :DIRECCION1_CLI, DIRECCION2_CLI = :DIRECCION2_CLI, POBLACION_CLI = :POBLACION_CLI, PROVINCIA_CLI = :PROVINCIA_CLI, CODIGO_POSTAL_CLI = :CODIGO_POSTAL_CLI, CODIGO_PAI_CLI = :CODIGO_PAI_CLI' +
