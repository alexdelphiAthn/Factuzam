        'IDA_FACLIN, PORCENTAJE_DTO_FACLIN, PRECIO_DTO_FACLIN, PRECIO_VENTA_SIVA_ARTICULO_FACLIN, PORCENTAJE_IVA_FACLIN, PRECIO_VENTA_CIVA_ARTICULO_FACLIN, TOTAL_FACLIN, TOTAL_FAC_SIVA_FACLIN, INSTANTE_MODIF, ' +
