        'PO_CANTIDAD_ARTICULO_FACTURA_LINEA, ESIMP_INCL_TARIFA_FACTURA_LI' +
        'NEA = :ESIMP_INCL_TARIFA_FACTURA_LINEA, TIPOIVA_ARTICULO_FACTURA' +
        '_LINEA = :TIPOIVA_ARTICULO_FACTURA_LINEA, DESCRIPCION_ARTICULO_F' +
        'ACTURA_LINEA = :DESCRIPCION_ARTICULO_FACTURA_LINEA, CODIGO_TARIF' +
        'A_FACTURA_LINEA = :CODIGO_TARIFA_FACTURA_LINEA, CANTIDAD_FACTURA' +
