        '_CLI, CODIGO_FP_CLI = :CODIGO_FP_CLI, TARIFA_ARTICULO_CLI = :TARIFA_ARTICULO_CLI, SERIE_CON_CLI = :SERIE_CON_CLI, TEXTO_LEGAL_FACTURA_CLI = :TEXTO_LEGAL_FACTURA_CLI, INSTANTE_MODIF = :INSTANTE_MODIF, ' +
