        'MOVIL_EMPRESA_FAC = :MOVIL_EMPRESA_FAC, EMAIL_EMPRESA_FAC = :EMAIL_EMPRESA_FAC, DIRECCION1_EMPRESA_FAC = :DIRECCION1_EMPRESA_FAC, DIRECCION2_EMPRESA_FAC = :DIRECCION2_EMPRESA_FAC, POBLACION_EMPRESA_FA' +
