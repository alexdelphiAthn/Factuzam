        ', NOMBRE_PAI_CLI, OBSERVACIONES_CLI, REFERENCIA_CLI, CONTACTO_CL' +
        'I, TELEFONO_CONTACTO_CLI, TELEFONO_CLI, IBAN_CLI, ESIVA_RECARGO_' +
        'CLI, ESRETENCIONES_CLI, TOTAL_LIMITE_CREDITO_CLI, ESPERMITE_DEUD' +
        'A_CLI, TOTAL_DEUDA_CLI, ESIVA_EXENTO_CLI, ESINTRACOMUNITARIO_CLI' +
        ', ESREGIMENESPECIALAGRICOLA_CLI, CODIGO_FP_CLI, TARIFA_ARTICULO_' +
