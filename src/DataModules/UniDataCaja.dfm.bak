  object qryDefinicionArticulo: TUniQuery
    SQL.Strings = (
      'SELECT DISTINCT '
      '    N.NOMBRE_ATRIBUTO, '
      '    N.ID_ATRIBUTO'
      'FROM fza_articulos_skus SKU'
      
        'JOIN fza_atributos_sku AT ON SKU.CODIGO_UNIDAD_SKU = AT.CODIGO_U' +
        'NIDAD_SA'
      'JOIN fza_atributos_valores V ON AT.ID_VALOR_SA = V.ID_VALOR_AV'
      'JOIN vi_atributos_nombres N ON V.ID_VA_AV = N.ID_ATRIBUTO'
      'WHERE SKU.CODIGO_ARTICULO_SKU = :ARTICULO'
      
        '-- IMPORTANTE: Ordenamos por ID o por un campo ORDEN_VISUAL si l' +
        'o tienes'
      'ORDER BY N.ID_ATRIBUTO ASC '
      'LIMIT 5;')
    Left = 540
    Top = 50
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'ARTICULO'
        Value = nil
      end>
  end
  object qryStock: TUniQuery
    SQL.Strings = (
      'CALL PRC_GET_CAJA_STOCK_PIVOTADO(:ARTICULO)')
    Left = 534
    Top = 150
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'ARTICULO'
        Value = nil
      end>
  end
