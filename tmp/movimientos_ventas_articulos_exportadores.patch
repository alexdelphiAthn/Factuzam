+procedure TPruebasExportadores.
+  Colores_MuestraDetallesSeparadosYConservaTotal;
+var
+  oDataSet: TClientDataSet;
+  oDoble: TDobleHojaCalculo;
+  oEscritor: IEscritorHojaCalculo;
+  oFormateador: IFormateadorHojaCalculo;
+begin
+  oDataSet := CrearDatosVentas;
+  try
+    AgregarFilaVenta(
+      oDataSet, 'ART-COLOR', 1, False, 'NEGRO', 'Negro ónix');
+    AgregarFilaVenta(oDataSet, 'ART-COLOR', 2, False, 'Azul');
+    AgregarFilaVenta(
+      oDataSet, 'ART-COLOR', 3, False, '', '(sin color)');
+    EjecutarExportacion(
+      oDataSet, oDoble, oEscritor, oFormateador);
+
+    Assert.AreEqual(
+      'ART-COLOR  Color: Negro ónix  Articulo ART-COLOR',
+      VarToStr(oDoble.Valor(4, 0)));
+    Assert.AreEqual(
+      'ART-COLOR  Color: Azul  Articulo ART-COLOR',
+      VarToStr(oDoble.Valor(5, 0)));
+    Assert.AreEqual(
+      'ART-COLOR  Color: (sin color)  Articulo ART-COLOR',
+      VarToStr(oDoble.Valor(6, 0)));
+    Assert.AreEqual('TOTAL GENERAL', VarToStr(oDoble.Valor(7, 0)));
+    Assert.AreEqual(60.0,
+      VarAsType(oDoble.Valor(7, 1), varDouble), 0.001);
+    Assert.AreEqual(480.0,
+      VarAsType(oDoble.Valor(7, 4), varDouble), 0.001);
+    Assert.AreEqual(240.0,
+      VarAsType(oDoble.Valor(7, 5), varDouble), 0.001);
+  finally
+    oFormateador := nil;
+    oEscritor := nil;
+    FreeAndNil(oDataSet);
+  end;
+end;
