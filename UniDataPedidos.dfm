  object unqryTablaG: TUniQuery
    SQLInsert.Strings = (
      'INSERT INTO fza_pedidos'
      
        '  (NRO_PEDIDO, SERIE_PEDIDO, FECHA_PEDIDO, CODIGO_EMPRESA_PEDIDO' +
        ', RAZONSOCIAL_EMPRESA_PEDIDO, NIF_EMPRESA_PEDIDO, MOVIL_EMPRESA_' +
        'PEDIDO, EMAIL_EMPRESA_PEDIDO, DIRECCION1_EMPRESA_PEDIDO, DIRECCI' +
        'ON2_EMPRESA_PEDIDO, POBLACION_EMPRESA_PEDIDO, PROVINCIA_EMPRESA_' +
        'PEDIDO, CODIGO_PAIS_EMPRESA_PEDIDO, NOMBRE_PAIS_EMPRESA_PEDIDO, ' +
        'CPOSTAL_EMPRESA_PEDIDO, ESRETENCIONES_EMPRESA_PEDIDO, GRUPO_ZONA' +
        '_IVA_EMPRESA_PEDIDO, ESREGIMENESPECIALAGRICOLA_EMPRESA_PEDIDO, C' +
        'ODIGO_CLIENTE_PEDIDO, NIF_CLIENTE_PEDIDO, EMAIL_CLIENTE_PEDIDO, ' +
        'REFERENCIAPS_PEDIDO, IDPS_PEDIDO, FECHAPS_PEDIDO, FORMAPAGOPS_PE' +
        'DIDO, TRANSPORTISTAPS_PEDIDO, ESTADOPEDIDOPS_PEDIDO, ESTADOMENSA' +
        'JEPS_PEDIDO, IDHILOPS_MENSAJES_PEDIDO, NOMBRE_CLIENTE_ENVIO_PEDI' +
        'DO, MOVIL_CLIENTE_ENVIO_PEDIDO, DIRECCION1_CLIENTE_ENVIO_PEDIDO,' +
        ' DIRECCION2_CLIENTE_ENVIO_PEDIDO, POBLACION_CLIENTE_ENVIO_PEDIDO' +
        ', PROVINCIA_CLIENTE_ENVIO_PEDIDO, CPOSTAL_CLIENTE_ENVIO_PEDIDO, ' +
        'CODIGO_PAIS_CLIENTE_ENVIO_PEDIDO, NOMBRE_PAIS_CLIENTE_ENVIO_PEDI' +
        'DO, RAZONSOCIAL_CLIENTE_FISCAL_PEDIDO, MOVIL_CLIENTE_FISCAL_PEDI' +
        'DO, EMAIL_CLIENTE_FISCAL_PEDIDO, DIRECCION1_CLIENTE_FISCAL_PEDID' +
        'O, DIRECCION2_CLIENTE_FISCAL_PEDIDO, POBLACION_CLIENTE_FISCAL_PE' +
        'DIDO, PROVINCIA_CLIENTE_FISCAL_PEDIDO, CPOSTAL_CLIENTE_FISCAL_PE' +
        'DIDO, CODIGO_PAIS_CLIENTE_FISCAL_PEDIDO, NOMBRE_PAIS_CLIENTE_FIS' +
        'CAL_PEDIDO, ESIVA_RECARGO_CLIENTE_PEDIDO, ESIVA_EXENTO_CLIENTE_P' +
        'EDIDO, ESREGIMENESPECIALAGRICOLA_CLIENTE_PEDIDO, ESRETENCIONES_C' +
        'LIENTE_PEDIDO, TARIFA_ARTICULO_CLIENTE_PEDIDO, ESIMP_INCL_TARIFA' +
        '_CLIENTE_PEDIDO, ESINTRACOMUNITARIO_CLIENTE_PEDIDO, ESIRPF_IMP_I' +
        'NCL_ZONA_IVA_PEDIDO, ESAPLICA_RE_ZONA_IVA_PEDIDO, ESIVAAGRICOLA_' +
        'ZONA_IVA_PEDIDO, PALABRA_REPORTS_ZONA_IVA_PEDIDO, CODIGO_IVA_PED' +
        'IDO, ESVENTA_ACTIVO_FIJO_PEDIDO, PORCEN_IVAN_PEDIDO, TOTAL_IVAN_' +
        'PEDIDO, PORCEN_REN_PEDIDO, TOTAL_REN_PEDIDO, TOTAL_BASEI_IVAN_PE' +
        'DIDO, PORCEN_IVAR_PEDIDO, TOTAL_IVAR_PEDIDO, PORCEN_RER_PEDIDO, ' +
        'TOTAL_RER_PEDIDO, TOTAL_BASEI_IVAR_PEDIDO, PORCEN_IVAS_PEDIDO, T' +
        'OTAL_IVAS_PEDIDO, PORCEN_RES_PEDIDO, TOTAL_RES_PEDIDO, TOTAL_BAS' +
        'EI_IVAS_PEDIDO, PORCEN_IVAE_PEDIDO, TOTAL_IVAE_PEDIDO, PORCEN_RE' +
        'E_PEDIDO, TOTAL_REE_PEDIDO, TOTAL_BASEI_IVAE_PEDIDO, TOTAL_BASES' +
        '_PEDIDO, TOTAL_IMPUESTOS_PEDIDO, FORMA_PAGO_PEDIDO, PORCEN_RETEN' +
        'CION_PEDIDO, TOTAL_RETENCION_PEDIDO, TOTAL_LIQUIDO_PEDIDO, TOTAL' +
        '_PAGADOREALPS_PEDIDO, NRO_PEDIDO_ABONO_PEDIDO, SERIE_PEDIDO_ABON' +
        'O_PEDIDO, TEXTO_LEGAL_PEDIDO_CLIENTE_PEDIDO, TEXTO_LEGAL_PEDIDO_' +
        'EMPRESA_PEDIDO, DOCUMENTO_PEDIDO, COMENTARIOS_PEDIDO, CONTADOR_L' +
        'INEAS_PEDIDO, ESCREARARTICULOS_PEDIDO, ESDESCRIPCIONES_AMP_PEDID' +
        'O, ESFECHADEENTREGA_PEDIDO, INSTANTEMODIF, INSTANTEALTA, USUARIO' +
        'ALTA, USUARIOMODIF)'
      'VALUES'
      
        '  (:NRO_PEDIDO, :SERIE_PEDIDO, :FECHA_PEDIDO, :CODIGO_EMPRESA_PE' +
        'DIDO, :RAZONSOCIAL_EMPRESA_PEDIDO, :NIF_EMPRESA_PEDIDO, :MOVIL_E' +
        'MPRESA_PEDIDO, :EMAIL_EMPRESA_PEDIDO, :DIRECCION1_EMPRESA_PEDIDO' +
        ', :DIRECCION2_EMPRESA_PEDIDO, :POBLACION_EMPRESA_PEDIDO, :PROVIN' +
        'CIA_EMPRESA_PEDIDO, :CODIGO_PAIS_EMPRESA_PEDIDO, :NOMBRE_PAIS_EM' +
        'PRESA_PEDIDO, :CPOSTAL_EMPRESA_PEDIDO, :ESRETENCIONES_EMPRESA_PE' +
        'DIDO, :GRUPO_ZONA_IVA_EMPRESA_PEDIDO, :ESREGIMENESPECIALAGRICOLA' +
        '_EMPRESA_PEDIDO, :CODIGO_CLIENTE_PEDIDO, :NIF_CLIENTE_PEDIDO, :E' +
        'MAIL_CLIENTE_PEDIDO, :REFERENCIAPS_PEDIDO, :IDPS_PEDIDO, :FECHAP' +
        'S_PEDIDO, :FORMAPAGOPS_PEDIDO, :TRANSPORTISTAPS_PEDIDO, :ESTADOP' +
        'EDIDOPS_PEDIDO, :ESTADOMENSAJEPS_PEDIDO, :IDHILOPS_MENSAJES_PEDI' +
        'DO, :NOMBRE_CLIENTE_ENVIO_PEDIDO, :MOVIL_CLIENTE_ENVIO_PEDIDO, :' +
        'DIRECCION1_CLIENTE_ENVIO_PEDIDO, :DIRECCION2_CLIENTE_ENVIO_PEDID' +
        'O, :POBLACION_CLIENTE_ENVIO_PEDIDO, :PROVINCIA_CLIENTE_ENVIO_PED' +
        'IDO, :CPOSTAL_CLIENTE_ENVIO_PEDIDO, :CODIGO_PAIS_CLIENTE_ENVIO_P' +
        'EDIDO, :NOMBRE_PAIS_CLIENTE_ENVIO_PEDIDO, :RAZONSOCIAL_CLIENTE_F' +
        'ISCAL_PEDIDO, :MOVIL_CLIENTE_FISCAL_PEDIDO, :EMAIL_CLIENTE_FISCA' +
        'L_PEDIDO, :DIRECCION1_CLIENTE_FISCAL_PEDIDO, :DIRECCION2_CLIENTE' +
        '_FISCAL_PEDIDO, :POBLACION_CLIENTE_FISCAL_PEDIDO, :PROVINCIA_CLI' +
        'ENTE_FISCAL_PEDIDO, :CPOSTAL_CLIENTE_FISCAL_PEDIDO, :CODIGO_PAIS' +
        '_CLIENTE_FISCAL_PEDIDO, :NOMBRE_PAIS_CLIENTE_FISCAL_PEDIDO, :ESI' +
        'VA_RECARGO_CLIENTE_PEDIDO, :ESIVA_EXENTO_CLIENTE_PEDIDO, :ESREGI' +
        'MENESPECIALAGRICOLA_CLIENTE_PEDIDO, :ESRETENCIONES_CLIENTE_PEDID' +
        'O, :TARIFA_ARTICULO_CLIENTE_PEDIDO, :ESIMP_INCL_TARIFA_CLIENTE_P' +
        'EDIDO, :ESINTRACOMUNITARIO_CLIENTE_PEDIDO, :ESIRPF_IMP_INCL_ZONA' +
        '_IVA_PEDIDO, :ESAPLICA_RE_ZONA_IVA_PEDIDO, :ESIVAAGRICOLA_ZONA_I' +
        'VA_PEDIDO, :PALABRA_REPORTS_ZONA_IVA_PEDIDO, :CODIGO_IVA_PEDIDO,' +
        ' :ESVENTA_ACTIVO_FIJO_PEDIDO, :PORCEN_IVAN_PEDIDO, :TOTAL_IVAN_P' +
        'EDIDO, :PORCEN_REN_PEDIDO, :TOTAL_REN_PEDIDO, :TOTAL_BASEI_IVAN_' +
        'PEDIDO, :PORCEN_IVAR_PEDIDO, :TOTAL_IVAR_PEDIDO, :PORCEN_RER_PED' +
        'IDO, :TOTAL_RER_PEDIDO, :TOTAL_BASEI_IVAR_PEDIDO, :PORCEN_IVAS_P' +
        'EDIDO, :TOTAL_IVAS_PEDIDO, :PORCEN_RES_PEDIDO, :TOTAL_RES_PEDIDO' +
        ', :TOTAL_BASEI_IVAS_PEDIDO, :PORCEN_IVAE_PEDIDO, :TOTAL_IVAE_PED' +
        'IDO, :PORCEN_REE_PEDIDO, :TOTAL_REE_PEDIDO, :TOTAL_BASEI_IVAE_PE' +
        'DIDO, :TOTAL_BASES_PEDIDO, :TOTAL_IMPUESTOS_PEDIDO, :FORMA_PAGO_' +
        'PEDIDO, :PORCEN_RETENCION_PEDIDO, :TOTAL_RETENCION_PEDIDO, :TOTA' +
        'L_LIQUIDO_PEDIDO, :TOTAL_PAGADOREALPS_PEDIDO, :NRO_PEDIDO_ABONO_' +
        'PEDIDO, :SERIE_PEDIDO_ABONO_PEDIDO, :TEXTO_LEGAL_PEDIDO_CLIENTE_' +
        'PEDIDO, :TEXTO_LEGAL_PEDIDO_EMPRESA_PEDIDO, :DOCUMENTO_PEDIDO, :' +
        'COMENTARIOS_PEDIDO, :CONTADOR_LINEAS_PEDIDO, :ESCREARARTICULOS_P' +
        'EDIDO, :ESDESCRIPCIONES_AMP_PEDIDO, :ESFECHADEENTREGA_PEDIDO, :I' +
        'NSTANTEMODIF, :INSTANTEALTA, :USUARIOALTA, :USUARIOMODIF)')
    SQLDelete.Strings = (
      'DELETE FROM fza_pedidos'
      'WHERE'
      
        '  NRO_PEDIDO = :Old_NRO_PEDIDO AND SERIE_PEDIDO = :Old_SERIE_PED' +
        'IDO')
    SQLUpdate.Strings = (
      'UPDATE fza_pedidos'
      'SET'
      
        '  NRO_PEDIDO = :NRO_PEDIDO, SERIE_PEDIDO = :SERIE_PEDIDO, FECHA_' +
        'PEDIDO = :FECHA_PEDIDO, CODIGO_EMPRESA_PEDIDO = :CODIGO_EMPRESA_' +
        'PEDIDO, RAZONSOCIAL_EMPRESA_PEDIDO = :RAZONSOCIAL_EMPRESA_PEDIDO' +
        ', NIF_EMPRESA_PEDIDO = :NIF_EMPRESA_PEDIDO, MOVIL_EMPRESA_PEDIDO' +
        ' = :MOVIL_EMPRESA_PEDIDO, EMAIL_EMPRESA_PEDIDO = :EMAIL_EMPRESA_' +
        'PEDIDO, DIRECCION1_EMPRESA_PEDIDO = :DIRECCION1_EMPRESA_PEDIDO, ' +
        'DIRECCION2_EMPRESA_PEDIDO = :DIRECCION2_EMPRESA_PEDIDO, POBLACIO' +
        'N_EMPRESA_PEDIDO = :POBLACION_EMPRESA_PEDIDO, PROVINCIA_EMPRESA_' +
