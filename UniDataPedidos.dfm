  object unqryPedidosLineas: TUniQuery
    SQLInsert.Strings = (
      'INSERT INTO fza_pedidos_lineas'
      
        '  (NRO_PEDIDO_LINEA, SERIE_PEDIDO_LINEA, LINEA_PEDIDO_LINEA, IDL' +
        'INEAPS_PEDIDO_LINEA, IDPRODPS_PEDIDO_LINEA, CODIGOPRODPS_PEDIDO_' +
        'LINEA, IDATRIBPRODPS_PEDIDO_LINEA, CODEAN13PRODPS_PEDIDO_LINEA, ' +
        'CODIGO_ARTICULO_PEDIDO_LINEA, CODIGO_FAMILIA_PEDIDO_LINEA, NOMBR' +
        'E_FAMILIA_PEDIDO_LINEA, FECHA_ENTREGA_PEDIDO_LINEA, TIPO_CANTIDA' +
        'D_ARTICULO_PEDIDO_LINEA, ESIMP_INCL_TARIFA_PEDIDO_LINEA, TIPOIVA' +
        '_ARTICULO_PEDIDO_LINEA, DESCRIPCION_ARTICULO_PEDIDO_LINEA, CODIG' +
        'O_TARIFA_PEDIDO_LINEA, CANTIDAD_PEDIDO_LINEA, PRECIOVENTA_SIVA_A' +
        'RTICULO_PEDIDO_LINEA, PORCEN_IVA_PEDIDO_LINEA, PRECIOVENTA_CIVA_' +
        'ARTICULO_PEDIDO_LINEA, TOTAL_PEDIDO_LINEA, INSTANTEMODIF, INSTAN' +
        'TEALTA, USUARIOALTA, USUARIOMODIF)'
      'VALUES'
      
        '  (:NRO_PEDIDO_LINEA, :SERIE_PEDIDO_LINEA, :LINEA_PEDIDO_LINEA, ' +
        ':IDLINEAPS_PEDIDO_LINEA, :IDPRODPS_PEDIDO_LINEA, :CODIGOPRODPS_P' +
        'EDIDO_LINEA, :IDATRIBPRODPS_PEDIDO_LINEA, :CODEAN13PRODPS_PEDIDO' +
        '_LINEA, :CODIGO_ARTICULO_PEDIDO_LINEA, :CODIGO_FAMILIA_PEDIDO_LI' +
        'NEA, :NOMBRE_FAMILIA_PEDIDO_LINEA, :FECHA_ENTREGA_PEDIDO_LINEA, ' +
        ':TIPO_CANTIDAD_ARTICULO_PEDIDO_LINEA, :ESIMP_INCL_TARIFA_PEDIDO_' +
        'LINEA, :TIPOIVA_ARTICULO_PEDIDO_LINEA, :DESCRIPCION_ARTICULO_PED' +
        'IDO_LINEA, :CODIGO_TARIFA_PEDIDO_LINEA, :CANTIDAD_PEDIDO_LINEA, ' +
        ':PRECIOVENTA_SIVA_ARTICULO_PEDIDO_LINEA, :PORCEN_IVA_PEDIDO_LINE' +
        'A, :PRECIOVENTA_CIVA_ARTICULO_PEDIDO_LINEA, :TOTAL_PEDIDO_LINEA,' +
        ' :INSTANTEMODIF, :INSTANTEALTA, :USUARIOALTA, :USUARIOMODIF)')
    SQLDelete.Strings = (
      'DELETE FROM fza_pedidos_lineas'
      'WHERE'
      
        '  NRO_PEDIDO_LINEA = :Old_NRO_PEDIDO_LINEA AND SERIE_PEDIDO_LINE' +
        'A = :Old_SERIE_PEDIDO_LINEA AND LINEA_PEDIDO_LINEA = :Old_LINEA_' +
        'PEDIDO_LINEA')
    SQLUpdate.Strings = (
      'UPDATE fza_pedidos_lineas'
      'SET'
      
        '  NRO_PEDIDO_LINEA = :NRO_PEDIDO_LINEA, SERIE_PEDIDO_LINEA = :SE' +
        'RIE_PEDIDO_LINEA, LINEA_PEDIDO_LINEA = :LINEA_PEDIDO_LINEA, IDLI' +
        'NEAPS_PEDIDO_LINEA = :IDLINEAPS_PEDIDO_LINEA, IDPRODPS_PEDIDO_LI' +
        'NEA = :IDPRODPS_PEDIDO_LINEA, CODIGOPRODPS_PEDIDO_LINEA = :CODIG' +
        'OPRODPS_PEDIDO_LINEA, IDATRIBPRODPS_PEDIDO_LINEA = :IDATRIBPRODP' +
        'S_PEDIDO_LINEA, CODEAN13PRODPS_PEDIDO_LINEA = :CODEAN13PRODPS_PE' +
        'DIDO_LINEA, CODIGO_ARTICULO_PEDIDO_LINEA = :CODIGO_ARTICULO_PEDI' +
        'DO_LINEA, CODIGO_FAMILIA_PEDIDO_LINEA = :CODIGO_FAMILIA_PEDIDO_L' +
        'INEA, NOMBRE_FAMILIA_PEDIDO_LINEA = :NOMBRE_FAMILIA_PEDIDO_LINEA' +
        ', FECHA_ENTREGA_PEDIDO_LINEA = :FECHA_ENTREGA_PEDIDO_LINEA, TIPO' +
        '_CANTIDAD_ARTICULO_PEDIDO_LINEA = :TIPO_CANTIDAD_ARTICULO_PEDIDO' +
        '_LINEA, ESIMP_INCL_TARIFA_PEDIDO_LINEA = :ESIMP_INCL_TARIFA_PEDI' +
        'DO_LINEA, TIPOIVA_ARTICULO_PEDIDO_LINEA = :TIPOIVA_ARTICULO_PEDI' +
        'DO_LINEA, DESCRIPCION_ARTICULO_PEDIDO_LINEA = :DESCRIPCION_ARTIC' +
        'ULO_PEDIDO_LINEA, CODIGO_TARIFA_PEDIDO_LINEA = :CODIGO_TARIFA_PE' +
        'DIDO_LINEA, CANTIDAD_PEDIDO_LINEA = :CANTIDAD_PEDIDO_LINEA, PREC' +
        'IOVENTA_SIVA_ARTICULO_PEDIDO_LINEA = :PRECIOVENTA_SIVA_ARTICULO_' +
        'PEDIDO_LINEA, PORCEN_IVA_PEDIDO_LINEA = :PORCEN_IVA_PEDIDO_LINEA' +
        ', PRECIOVENTA_CIVA_ARTICULO_PEDIDO_LINEA = :PRECIOVENTA_CIVA_ART' +
        'ICULO_PEDIDO_LINEA, TOTAL_PEDIDO_LINEA = :TOTAL_PEDIDO_LINEA, IN' +
        'STANTEMODIF = :INSTANTEMODIF, INSTANTEALTA = :INSTANTEALTA, USUA' +
        'RIOALTA = :USUARIOALTA, USUARIOMODIF = :USUARIOMODIF'
      'WHERE'
      
        '  NRO_PEDIDO_LINEA = :Old_NRO_PEDIDO_LINEA AND SERIE_PEDIDO_LINE' +
        'A = :Old_SERIE_PEDIDO_LINEA AND LINEA_PEDIDO_LINEA = :Old_LINEA_' +
        'PEDIDO_LINEA')
    SQLLock.Strings = (
      
        'SELECT NRO_PEDIDO_LINEA, SERIE_PEDIDO_LINEA, LINEA_PEDIDO_LINEA,' +
        ' IDLINEAPS_PEDIDO_LINEA, IDPRODPS_PEDIDO_LINEA, CODIGOPRODPS_PED' +
        'IDO_LINEA, IDATRIBPRODPS_PEDIDO_LINEA, CODEAN13PRODPS_PEDIDO_LIN' +
        'EA, CODIGO_ARTICULO_PEDIDO_LINEA, CODIGO_FAMILIA_PEDIDO_LINEA, N' +
        'OMBRE_FAMILIA_PEDIDO_LINEA, FECHA_ENTREGA_PEDIDO_LINEA, TIPO_CAN' +
        'TIDAD_ARTICULO_PEDIDO_LINEA, ESIMP_INCL_TARIFA_PEDIDO_LINEA, TIP' +
        'OIVA_ARTICULO_PEDIDO_LINEA, DESCRIPCION_ARTICULO_PEDIDO_LINEA, C' +
        'ODIGO_TARIFA_PEDIDO_LINEA, CANTIDAD_PEDIDO_LINEA, PRECIOVENTA_SI' +
        'VA_ARTICULO_PEDIDO_LINEA, PORCEN_IVA_PEDIDO_LINEA, PRECIOVENTA_C' +
        'IVA_ARTICULO_PEDIDO_LINEA, TOTAL_PEDIDO_LINEA, INSTANTEMODIF, IN' +
        'STANTEALTA, USUARIOALTA, USUARIOMODIF FROM fza_pedidos_lineas'
      'WHERE'
      
        '  NRO_PEDIDO_LINEA = :Old_NRO_PEDIDO_LINEA AND SERIE_PEDIDO_LINE' +
        'A = :Old_SERIE_PEDIDO_LINEA AND LINEA_PEDIDO_LINEA = :Old_LINEA_' +
        'PEDIDO_LINEA'
      'FOR UPDATE')
    SQLRefresh.Strings = (
      
        'SELECT NRO_PEDIDO_LINEA, SERIE_PEDIDO_LINEA, LINEA_PEDIDO_LINEA,' +
        ' IDLINEAPS_PEDIDO_LINEA, IDPRODPS_PEDIDO_LINEA, CODIGOPRODPS_PED' +
        'IDO_LINEA, IDATRIBPRODPS_PEDIDO_LINEA, CODEAN13PRODPS_PEDIDO_LIN' +
        'EA, CODIGO_ARTICULO_PEDIDO_LINEA, CODIGO_FAMILIA_PEDIDO_LINEA, N' +
        'OMBRE_FAMILIA_PEDIDO_LINEA, FECHA_ENTREGA_PEDIDO_LINEA, TIPO_CAN' +
        'TIDAD_ARTICULO_PEDIDO_LINEA, ESIMP_INCL_TARIFA_PEDIDO_LINEA, TIP' +
        'OIVA_ARTICULO_PEDIDO_LINEA, DESCRIPCION_ARTICULO_PEDIDO_LINEA, C' +
        'ODIGO_TARIFA_PEDIDO_LINEA, CANTIDAD_PEDIDO_LINEA, PRECIOVENTA_SI' +
        'VA_ARTICULO_PEDIDO_LINEA, PORCEN_IVA_PEDIDO_LINEA, PRECIOVENTA_C' +
        'IVA_ARTICULO_PEDIDO_LINEA, TOTAL_PEDIDO_LINEA, INSTANTEMODIF, IN' +
        'STANTEALTA, USUARIOALTA, USUARIOMODIF FROM fza_pedidos_lineas'
      'WHERE'
      
        '  NRO_PEDIDO_LINEA = :NRO_PEDIDO_LINEA AND SERIE_PEDIDO_LINEA = ' +
        ':SERIE_PEDIDO_LINEA AND LINEA_PEDIDO_LINEA = :LINEA_PEDIDO_LINEA')
    SQLRecCount.Strings = (
      'SELECT COUNT(*) FROM fza_pedidos_lineas')
    Connection = dmConn.conUni
    SQL.Strings = (
      'SELECT * FROM vi_pedidos_lineas')
    MasterFields = 'NRO_PEDIDO;SERIE_PEDIDO'
    DetailFields = 'NRO_PEDIDO_LINEA;SERIE_PEDIDO_LINEA'
    AfterInsert = unqryPedidosLineasAfterInsert
    BeforePost = unqryPedidosLineasBeforePost
    Left = 48
    Top = 80
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'NRO_PEDIDO'
        Value = nil
      end
      item
        DataType = ftUnknown
        Name = 'SERIE_PEDIDO'
        Value = nil
      end>
  end
